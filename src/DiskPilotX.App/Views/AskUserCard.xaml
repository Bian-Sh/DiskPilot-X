<UserControl x:Class="DiskPilotX.App.Views.AskUserCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
    MinWidth="220" MaxHeight="420" HorizontalAlignment="Stretch"
    Foreground="{DynamicResource VP.TextPrimaryBrush}"
    AutomationProperties.Name="用户决策卡片">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Template" Value="{DynamicResource VP.TextBoxTemplate}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource VP.TextPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource VP.AccentBrush}"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}"/>
      <Setter Property="Template" Value="{DynamicResource VP.ButtonTemplate}"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="50"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <DataTemplate DataType="{x:Type vm:AskUserSingleSelectFieldViewModel}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Margin="0,0,0,6" Padding="9,6" CornerRadius="{DynamicResource VP.ControlCornerRadius}" BorderThickness="1"
                    BorderBrush="{DynamicResource VP.BorderLightBrush}" Background="{DynamicResource VP.SurfaceBrush}">
              <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="SingleChoice_OnClick"
                           Foreground="{DynamicResource VP.TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                           AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                             Foreground="{DynamicResource VP.TextSecondaryBrush}"
                             Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </RadioButton>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border BorderBrush="{DynamicResource VP.BorderAccentSoftBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="0,2,0,5"
                Visibility="{Binding AllowsCustomInput, Converter={StaticResource BoolVis}}">
          <TextBlock Text="{Binding CustomInputPlaceholder}" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
        </Border>
        <TextBox Text="{Binding CustomInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding CustomInputMaxLength}" ToolTip="{Binding CustomInputPlaceholder}"
                 AutomationProperties.Name="其他答案" AutomationProperties.HelpText="{Binding CustomInputPlaceholder}"
                 Visibility="{Binding AllowsCustomInput, Converter={StaticResource BoolVis}}"
                 PreviewKeyDown="Input_OnKeyDown"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AskUserMultiSelectFieldViewModel}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Margin="0,0,0,6" Padding="9,6" CornerRadius="{DynamicResource VP.ControlCornerRadius}" BorderThickness="1"
                    BorderBrush="{DynamicResource VP.BorderLightBrush}" Background="{DynamicResource VP.SurfaceBrush}">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Foreground="{DynamicResource VP.TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                             Foreground="{DynamicResource VP.TextSecondaryBrush}"
                             Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </CheckBox>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border BorderBrush="{DynamicResource VP.BorderAccentSoftBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="0,2,0,5"
                Visibility="{Binding AllowsCustomInput, Converter={StaticResource BoolVis}}">
          <TextBlock Text="{Binding CustomInputPlaceholder}" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
        </Border>
        <TextBox Text="{Binding CustomInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding CustomInputMaxLength}" ToolTip="{Binding CustomInputPlaceholder}"
                 AutomationProperties.Name="其他答案" AutomationProperties.HelpText="{Binding CustomInputPlaceholder}"
                 Visibility="{Binding AllowsCustomInput, Converter={StaticResource BoolVis}}"
                 PreviewKeyDown="Input_OnKeyDown"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AskUserNumberFieldViewModel}">
      <StackPanel>
        <TextBox Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Label}" PreviewKeyDown="Input_OnKeyDown"/>
        <TextBlock Text="{Binding RangeHint}" FontSize="11" Margin="0,4,0,0"
                   Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AskUserTextFieldViewModel}">
      <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="{Binding IsMultiline}" MaxLength="{Binding MaxLength}"
               TextWrapping="Wrap" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="{Binding Label}" PreviewKeyDown="Input_OnKeyDown"/>
    </DataTemplate>
  </UserControl.Resources>
  <Border Padding="8,6" CornerRadius="14" BorderThickness="1"
          Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}">
    <Grid IsEnabled="{Binding IsActive}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="8,5,3,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Grid.Column="1" Width="22" Height="22" MinWidth="22" MinHeight="22" Margin="0" Padding="0"
                ToolTip="取消" AutomationProperties.Name="取消" Cursor="Hand" VerticalAlignment="Top"
                Visibility="{Binding AllowCancel, Converter={StaticResource BoolVis}}" Click="Cancel_OnClick">
          <Button.Template><ControlTemplate TargetType="Button">
            <Grid><Ellipse x:Name="Circle" Fill="{DynamicResource VP.DangerBrush}"/>
              <Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource VP.DangerPressedBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border BorderBrush="{DynamicResource VP.BorderAccentSoftBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="0,0,0,8"><StackPanel>
          <TextBlock Text="{Binding Question}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Description}" Margin="0,0,0,6" FontSize="12"
                     Foreground="{DynamicResource VP.TextSecondaryBrush}"
                     Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
          <Border Padding="8,6" Margin="0,0,0,8" CornerRadius="{DynamicResource VP.ControlCornerRadius}" Background="{DynamicResource VP.WarningSurfaceBrush}"
                  Visibility="{Binding HasImpactSummary, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ImpactSummary}"/>
          </Border>
          <TextBlock Margin="0,4,0,8" FontWeight="SemiBold"><Run Text="{Binding CurrentField.Label, Mode=OneWay}"/><Run Text="{Binding CurrentField.RequiredSuffix, Mode=OneWay}"/></TextBlock>
          </StackPanel></Border>
          <ContentControl x:Name="FieldContent" Content="{Binding CurrentField}"/>
          <TextBlock Text="{Binding CurrentField.ErrorMessage}" Foreground="{DynamicResource VP.DangerBrush}" Margin="0,6,0,0"
                     AutomationProperties.LiveSetting="Assertive"
                     Visibility="{Binding CurrentField.HasError, Converter={StaticResource BoolVis}}"/>
          <TextBlock Text="{Binding ErrorSummary}" Foreground="{DynamicResource VP.DangerBrush}" FontSize="12" Margin="0,4,0,0"
                     Visibility="{Binding HasErrors, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="2,12,2,3" Height="28">
        <!-- 两侧预留同等宽度，使分页组在卡片中居中，并为共用发送按钮留位。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="32,0">
          <Button x:Name="PreviousButton" Content="上一题" Width="52" MinWidth="52" Height="28" MinHeight="28" Padding="0" Margin="0"
                  FontSize="12" IsEnabled="{Binding HasPreviousField}" Click="Previous_OnClick"
                  ToolTip="上一题" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="上一题"/>
          <TextBlock Text="{Binding StepText}" VerticalAlignment="Center" Margin="6,0" FontSize="11"/>
          <Button x:Name="NextButton" Content="下一题" Width="52" MinWidth="52" Height="28" MinHeight="28" Padding="0" Margin="0"
                  FontSize="12" IsEnabled="{Binding HasNextField}" Click="Next_OnClick"
                  ToolTip="下一题" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="下一题"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
