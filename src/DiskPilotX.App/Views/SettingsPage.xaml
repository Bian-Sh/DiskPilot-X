<UserControl x:Class="DiskPilotX.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
             xmlns:settings="clr-namespace:DiskPilotX.App.Views.SettingsSections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource VP.FontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- 作为宿主 SettingsWindow 的内容根：底色与圆角由窗口外壳统一提供，这里保持透明以透出磨砂材质。 -->
        <Border x:Name="CardBorder" Background="Transparent" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="124" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="16,20,8,20">
                    <StackPanel>
                        <Button x:Name="GeneralNavButton"
                                Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc SettingsGeneralNav}"
                                Tag="GeneralSectionControl"
                                Click="SettingsNavButton_Click" />
                        <Button x:Name="ThemeNavButton"
                                Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc ThemeSectionLabel}"
                                Tag="ThemeSectionControl"
                                Click="SettingsNavButton_Click" />
                        <Button x:Name="ApiNavButton"
                                Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc AnthropicApiKeyHeader}"
                                Tag="ApiSectionControl"
                                Click="SettingsNavButton_Click" />
                        <Button x:Name="WhitelistNavButton"
                                Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc SettingsWhitelistNav}"
                                Tag="WhitelistSectionControl"
                                Click="SettingsNavButton_Click" />
                        <Button x:Name="UpdateNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc UpdateSettingsTitle}" Tag="UpdateSectionControl" Click="SettingsNavButton_Click" />
                        <Button x:Name="DisclaimerNavButton"
                                Style="{StaticResource SettingsNavButtonStyle}"
                                Content="{loc:Loc SettingsDisclaimerNav}"
                                Tag="DisclaimerSectionControl"
                                Click="SettingsNavButton_Click" />
                    </StackPanel>
                </Grid>
                <!-- Scrollable content -->

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,18" ScrollChanged="SettingsScrollViewer_ScrollChanged">
                    <StackPanel x:Name="SettingsContentPanel" SizeChanged="SettingsContentPanel_SizeChanged">

                        <settings:GeneralSettingsSection x:Name="GeneralSectionControl"
                                                         Margin="0,18,0,0" />
                        <settings:ThemeSettingsSection x:Name="ThemeSectionControl"
                                                       Margin="0,18,0,0" />
                        <settings:ApiSettingsSection x:Name="ApiSectionControl"
                                                     Margin="0,18,0,0" />
                        <settings:WhitelistSettingsSection x:Name="WhitelistSectionControl"
                                                           Margin="0,18,0,0" />
                        <settings:UpdateSettingsSection x:Name="UpdateSectionControl" Margin="0,18,0,0" />
                        <settings:DisclaimerSettingsSection x:Name="DisclaimerSectionControl"
                                                            Margin="0,18,0,0" />
                        <Border x:Name="BottomScrollSpacer" Height="0" />
                    </StackPanel>
                </ScrollViewer>


                <!-- 设置操作反馈 -->
                <Border x:Name="SettingsToast" Grid.Column="1" HorizontalAlignment="Right" IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        Background="{DynamicResource VP.AccentBrush}"
                        CornerRadius="10"
                        Padding="14,8"
                        Margin="0,16,16,0"
                        Visibility="{Binding IsSaveToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SaveToastMessage}" MaxWidth="280" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="White"
                               FontSize="12" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>





