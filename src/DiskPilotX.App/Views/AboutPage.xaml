<UserControl x:Class="DiskPilotX.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
             xmlns:converters="clr-namespace:DiskPilotX.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             FontFamily="{DynamicResource VP.FontFamily}">

    <UserControl.Resources>
        <converters:MarkdownToFlowDocumentConverter x:Key="MarkdownConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource VP.SurfaceBrush}"
            BorderBrush="{DynamicResource VP.BorderLightBrush}"
            BorderThickness="0.5,0,0.5,0.5"
            CornerRadius="0,0,10,10">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.3"
                              Direction="270" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center">

            <!-- 标题行：标题居中，投喂入口靠右，互不影响 -->
            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,0">
                <TextBlock Text="DiskPilot-X"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource VP.TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" />
                <TextBlock x:Name="DonateLink"
                           FontSize="12"
                           Cursor="Hand"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4"
                           MouseLeftButtonDown="DonateLink_Click">
                    <Run Text="☕ " Foreground="{DynamicResource VP.AccentTextBrush}" />
                    <Run Text="{loc:Loc BuyMeCoffee}" Foreground="{DynamicResource VP.AccentTextBrush}" />
                </TextBlock>
            </Grid>
            <TextBlock Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VP.TextSecondaryBrush}"
                       FontSize="14">
                <Run Text="{loc:Loc VersionLabel}" />
                <Run Text="{Binding CurrentVersion}" />
            </TextBlock>

            <!-- 应用介绍 -->
            <TextBlock Margin="0,20,0,0"
                       Text="{loc:Loc AboutDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource VP.TextSecondaryBrush}"
                       FontSize="13.5"
                       LineHeight="22"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <!-- GitHub 链接 -->
            <TextBlock Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="13">
                <Run Text="{loc:Loc GithubLabel}" Foreground="{DynamicResource VP.TextSecondaryBrush}" />
                <Run Text=": " Foreground="{DynamicResource VP.TextSecondaryBrush}" />
                <Hyperlink NavigateUri="https://github.com/Bian-Sh/DiskPilot-X"
                           Foreground="{DynamicResource VP.AccentTextBrush}"
                           TextDecorations="None"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="github.com/Bian-Sh/DiskPilot-X" />
                </Hyperlink>
            </TextBlock>

            <!-- 分隔线 -->
            <Rectangle Height="1" Margin="0,24,0,0"
                       Fill="{DynamicResource VP.BorderSubtleBrush}" />

            <!-- 更新操作统一收敛到标题栏与设置页。 -->
            <Border Margin="0,20,0,0" Padding="16" CornerRadius="10"
                    Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:Loc UpdateAboutHint}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
