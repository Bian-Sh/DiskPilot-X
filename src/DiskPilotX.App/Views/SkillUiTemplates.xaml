<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:c="clr-namespace:DiskPilotX.App.Converters"
                    xmlns:models="clr-namespace:DiskPilotX.Core.Models;assembly=DiskPilotX.Core">

  <c:BoolToVisibilityConverter x:Key="SecBoolVis"/>
  <c:NullToVisibilityConverter x:Key="SecNullVis"/>
  <c:ToneToBrushConverter x:Key="SecToneBrush"/>
  <c:RatioToLengthConverter x:Key="SecRatioLen" Factor="260"/>
  <!-- 卸载类动作用危险色按钮；资源必须声明在引用它的模板之前 -->
  <c:ItemActionStyleConverter x:Key="SecItemActionStyle"/>

  <!-- 条目行内动作按钮：卸载 = 危险色，其余走通用按钮 -->
  <DataTemplate x:Key="ItemActionButton" DataType="{x:Type models:SkillUiItem}">
    <Button Content="{Binding Action.Label}"
            ToolTip="{Binding Action.Target}"
            Visibility="{Binding HasAction,Converter={StaticResource SecBoolVis}}"
            Style="{Binding Action.IsUninstall,Converter={StaticResource SecItemActionStyle}}"
            Padding="8,4" FontSize="10.5" Cursor="Hand" HorizontalAlignment="Left"/>
  </DataTemplate>

  <!-- 视图区块：按 kind 选择布局，气泡与窗口共用 -->
  <DataTemplate DataType="{x:Type models:SkillUiSection}">
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,0,0,8" Visibility="{Binding HasTitle,Converter={StaticResource SecBoolVis}}"/>
      <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasSubtitle,Converter={StaticResource SecBoolVis}}"/>

      <!-- 海报网格：一行多卡 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsPosterGrid,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="132" CornerRadius="10" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" Padding="7" Margin="0,0,10,10">
              <StackPanel>
                <Grid Height="186">
                  <Border CornerRadius="7" Background="{DynamicResource VP.SurfaceHoverBrush}" ClipToBounds="True">
                    <Image Stretch="UniformToFill" c:PosterLoader.SourceUrl="{Binding ImageUrl}" Visibility="{Binding HasImage,Converter={StaticResource SecBoolVis}}"/>
                  </Border>
                  <TextBlock Text="暂无封面" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                      <DataTrigger Binding="{Binding ImageState}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VP.AccentBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Subtitle,Converter={StaticResource SecNullVis}}"/>
                <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" Content="选中" FontSize="10" Margin="0,4,0,0" Visibility="{Binding Selectable,Converter={StaticResource SecBoolVis}}"/>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemActionButton}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 统计行 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsStatRow,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="128" CornerRadius="10" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                <TextBlock Text="{Binding ValueLabel}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" Visibility="{Binding ValueLabel,Converter={StaticResource SecNullVis}}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 表格 -->
      <StackPanel Visibility="{Binding IsTable,Converter={StaticResource SecBoolVis}}">
        <ItemsControl ItemsSource="{Binding Headers}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="{Binding ColumnCount}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Border Padding="6,3" BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- 行尾放行内动作（卸载）；单元格列表作为最后子节点撑满剩余宽度 -->
              <DockPanel LastChildFill="True" Margin="0,0,0,1">
                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Content="{Binding}" ContentTemplate="{StaticResource ItemActionButton}"/>
                <ItemsControl ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Border Padding="6,3" BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 条形图 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsBarChart,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ProgressBar Grid.Column="1" Height="10" Minimum="0" Value="{Binding Metric}" Maximum="{Binding DataContext.MaxMetric, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Background="{DynamicResource VP.SurfaceHoverBrush}" Foreground="{DynamicResource VP.AccentBrush}" BorderThickness="0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 文本 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsText,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Subtitle,Converter={StaticResource SecNullVis}}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
