<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:c="clr-namespace:DiskPilotX.App.Converters"
                    xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
                    xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
                    xmlns:models="clr-namespace:DiskPilotX.Core.Models;assembly=DiskPilotX.Core">

  <c:BoolToVisibilityConverter x:Key="SecBoolVis"/>
  <c:NullToVisibilityConverter x:Key="SecNullVis"/>
  <c:ToneToBrushConverter x:Key="SecToneBrush"/>
  <c:RatioToLengthConverter x:Key="SecRatioLen" Factor="260"/>
  <!-- 卸载类动作用危险色按钮；资源必须声明在引用它的模板之前 -->
  <c:ItemActionStyleConverter x:Key="SecItemActionStyle"/>

  <!-- 条目行内动作按钮：卸载 = 危险色，其余走通用按钮 -->
  <DataTemplate x:Key="ItemActionButton" DataType="{x:Type models:SkillUiItem}">
    <Button Content="{loc:SkillText Action.Label}"
            ToolTip="{Binding Action.Target}"
            Visibility="{Binding HasAction,Converter={StaticResource SecBoolVis}}"
            Style="{Binding Action.IsUninstall,Converter={StaticResource SecItemActionStyle}}"
            Padding="8,4" FontSize="10.5" Cursor="Hand" HorizontalAlignment="Left"/>
  </DataTemplate>

  <!-- 视图区块：按 kind 选择布局，气泡与窗口共用 -->
  <DataTemplate DataType="{x:Type models:SkillUiSection}">
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="{loc:SkillText Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,0,0,8" Visibility="{Binding HasTitle,Converter={StaticResource SecBoolVis}}"/>
      <TextBlock Text="{loc:SkillText Subtitle}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasSubtitle,Converter={StaticResource SecBoolVis}}"/>

      <!-- 海报网格：一行多卡 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsPosterGrid,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="132" CornerRadius="10" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" Padding="7" Margin="0,0,10,10">
              <StackPanel>
                <Grid Height="186">
                  <Border CornerRadius="7" Background="{DynamicResource VP.SurfaceHoverBrush}" ClipToBounds="True">
                    <Image Stretch="UniformToFill" c:PosterLoader.SourceUrl="{Binding ImageUrl}" Visibility="{Binding HasImage,Converter={StaticResource SecBoolVis}}"/>
                  </Border>
                  <TextBlock Text="{loc:Loc SkillNoCover}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                      <DataTrigger Binding="{Binding ImageState}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock Text="{loc:SkillText Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="{loc:SkillText Value}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VP.AccentBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{loc:SkillText Subtitle}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Subtitle,Converter={StaticResource SecNullVis}}"/>
                <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" Content="{loc:Loc SkillSelected}" FontSize="10" Margin="0,4,0,0" Visibility="{Binding Selectable,Converter={StaticResource SecBoolVis}}"/>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemActionButton}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 统计行 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsStatRow,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="128" CornerRadius="10" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Text="{loc:SkillText Title}" FontSize="10" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:SkillText Value}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                <TextBlock Text="{loc:SkillText ValueLabel}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" Visibility="{Binding ValueLabel,Converter={StaticResource SecNullVis}}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 表格统一由宿主组件提供布局与选择交互，技能只声明数据。 -->
      <controls:SkillTableControl Section="{Binding}" Visibility="{Binding IsTable,Converter={StaticResource SecBoolVis}}"/>

      <!-- 所有显式图表复用宿主组件，聊天与弹窗使用同一契约。 -->
      <controls:SkillChartControl Section="{Binding}" Visibility="{Binding IsChart,Converter={StaticResource SecBoolVis}}"/>

      <!-- 文本 -->
      <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsText,Converter={StaticResource SecBoolVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{loc:SkillText Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:SkillText Subtitle}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Subtitle,Converter={StaticResource SecNullVis}}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
