<UserControl x:Class="DiskPilotX.App.Views.SettingsSections.ThemeSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
             xmlns:theme="clr-namespace:DiskPilotX.Core.Models.Theme;assembly=DiskPilotX.Core"
             xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource VP.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="ThemeSectionAnchor" Text="{loc:Loc ThemeSectionLabel}"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource VP.TextSecondaryBrush}"
                   Margin="0,16,0,10" />

        <Border x:Name="ThemeSection" Background="{DynamicResource VP.SettingsCardBrush}"
                BorderBrush="{DynamicResource VP.BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <!-- Theme Color Picker + Presets inline -->
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{loc:Loc ThemeAccentColorLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc ThemeAccentColorHint}"
                               Margin="0,0,0,8" />

                    <!-- Presets row -->
                    <ItemsControl Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableThemePresets}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type theme:ThemeProfile}">
                                <Border Style="{StaticResource ThemePresetCardStyle}"
                                        MouseLeftButtonDown="ThemePreset_Click"
                                        Tag="{Binding}"
                                        Width="Auto" Margin="0,0,6,0" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Margin="0,0,6,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding BackgroundColor, Converter={StaticResource HexColorConverter}}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource VP.TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Color Picker -->
                    <controls:ColorPickerControl x:Name="ThemeColorPicker"
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        SelectedColor="{Binding ThemeBackgroundColor, Mode=TwoWay}" />
                </Grid>

                <!-- Glass / Frosted Glass Toggle -->
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc ThemeGlassLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc ThemeGlassHint}" />
                    <CheckBox Grid.Column="1"
                              Style="{DynamicResource VP.CheckBox}"
                              IsChecked="{Binding GlassEnabled}"
                              Content="{loc:Loc ThemeGlassOption}" />
                </Grid>

                <!-- 只控制材质外观，不改变窗口的真实输入焦点。 -->
                <Separator Margin="14,0" />
                <Grid Margin="14,12" IsEnabled="{Binding GlassEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc ThemeKeepGlassInactiveLabel}" Style="{StaticResource SettingsLabelStyle}" ToolTip="{loc:Loc ThemeKeepGlassInactiveHint}"/>
                    <CheckBox x:Name="KeepBackgroundGlassToggle" Grid.Column="1" Style="{DynamicResource VP.CheckBox}"
                              IsChecked="{Binding KeepGlassWhenInactive}" Content="{loc:Loc ThemeKeepGlassInactiveOption}"
                              AutomationProperties.Name="{loc:Loc ThemeKeepGlassInactiveLabel}" ToolTip="{loc:Loc ThemeKeepGlassInactiveHint}"/>
                </Grid>
                <!-- 统一磨砂材质的背景透明度调节。 -->
                <Separator Margin="14,0" />
                <Grid Margin="14,12" IsEnabled="{Binding GlassEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc ThemeOpacityLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc ThemeOpacityHint}" />
                    <Slider x:Name="GlassTransparencySlider" Grid.Column="1"
                            AutomationProperties.Name="{loc:Loc ThemeOpacityLabel}"
                            Minimum="0" Maximum="100"
                            SmallChange="5" LargeChange="10"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding GlassOpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding GlassOpacityPercent, StringFormat={}{0:F0}%}"
                               Foreground="{DynamicResource VP.TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
                </Grid>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
