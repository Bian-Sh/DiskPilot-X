<UserControl x:Class="DiskPilotX.App.Views.SettingsSections.GeneralSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
             xmlns:enums="clr-namespace:DiskPilotX.Core.Enums;assembly=DiskPilotX.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource VP.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="GeneralSectionAnchor" Text="{loc:Loc SettingsGeneralNav}"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource VP.TextSecondaryBrush}"
                   Margin="0,16,0,10" />
        <Border x:Name="GeneralSection" Background="{DynamicResource VP.SettingsCardBrush}"
                BorderBrush="{DynamicResource VP.BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsLanguageLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsLanguageHint}" />
                    <ComboBox Grid.Column="1"
                              Style="{DynamicResource VP.ComboBox}"
                              ItemsSource="{x:Static vm:SettingsViewModel.LanguageOptions}"
                              SelectedValue="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="DisplayName" />
                </Grid>
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc SettingsDefaultCleanupModeLabel}" Style="{StaticResource SettingsLabelStyle}" />
                        <TextBlock x:Name="CleanupModeHelp" Text="?" Cursor="Help" Margin="6,0,0,0" Width="16" TextAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource VP.TextTertiaryBrush}"
                                   ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="12000"
                                   AutomationProperties.Name="{loc:Loc SettingsDefaultCleanupModeHint}">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="1000" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{loc:Loc SettingsDefaultCleanupModeHint}" TextAlignment="Left" TextWrapping="Wrap" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="CleanupModeInput" Grid.Column="1"
                              Style="{DynamicResource VP.ComboBox}"
                              AutomationProperties.Name="{loc:Loc SettingsDefaultCleanupModeLabel}"
                              SelectedValuePath="Tag" SelectedValue="{Binding SelectedDeletionMode}">
                        <ComboBoxItem Tag="{x:Static enums:DeletionMode.MoveToRecycleBin}" Content="{loc:Loc MoveToRecycleBinOption}" />
                        <ComboBoxItem Tag="{x:Static enums:DeletionMode.PermanentDelete}" Content="{loc:Loc PermanentlyDeleteOption}" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
