<UserControl x:Class="DiskPilotX.App.Views.SettingsSections.UpdateSettingsSection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:DiskPilotX.App.Localization" xmlns:converters="clr-namespace:DiskPilotX.App.Converters"
 Loaded="Section_Loaded" IsVisibleChanged="Section_IsVisibleChanged" FontFamily="{DynamicResource VP.FontFamily}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <converters:ReleaseNotesMarkdownConverter x:Key="Markdown"/>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{loc:Loc UpdateSettingsTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,0,0,14"/>
  <Border Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
   <StackPanel>
    <TextBlock Foreground="{DynamicResource VP.TextPrimaryBrush}" FontWeight="SemiBold"><Run Text="{loc:Loc VersionLabel}"/><Run Text="{Binding CurrentVersion}"/></TextBlock>
    <CheckBox Content="{loc:Loc UpdateAutoCheck}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,14,0,8" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
    <CheckBox Content="{loc:Loc UpdateUseProxy}" IsChecked="{Binding UseProxyForUpdates}" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
    <TextBlock Text="{loc:Loc UpdateProxyHint}" TextWrapping="Wrap" FontSize="12" Margin="22,5,0,12" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
    <WrapPanel>
     <Button Content="{loc:Loc UpdateCheckNow}" Command="{Binding CheckForUpdateCommand}" IsEnabled="{Binding CanCheck}" Style="{DynamicResource VP.Button}" Margin="0,0,10,6"/>
     <Button Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}" IsEnabled="{Binding CanUsePrimaryAction}" Visibility="{Binding IsUpdateEntryVisible, Converter={StaticResource BoolToVis}}" Style="{DynamicResource VP.AccentButton}" Margin="0,0,0,6"/>
    </WrapPanel>
    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
   </StackPanel>
  </Border>
  <TextBlock Text="{loc:Loc UpdateHistoryTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,20,0,10"/>
  <Border BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource VP.SurfaceBrush}" ClipToBounds="True">
   <Grid Height="430">
    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="0,0,1,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource VP.TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc UpdateHistoryTitle}">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="6,8">
         <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
         <WrapPanel Margin="0,4,0,4">
          <TextBlock Text="{loc:Loc UpdateLatestBadge}" Foreground="{DynamicResource VP.AccentTextBrush}" FontSize="10" Margin="0,0,5,0" Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{loc:Loc UpdateCurrentBadge}" Foreground="{DynamicResource VP.SuccessTextBrush}" FontSize="10" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
         </WrapPanel>
         <TextBlock Text="{Binding PublishedAt}" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Row="1" Content="{loc:Loc UpdateLoadMore}" Command="{Binding LoadMoreHistoryCommand}" Style="{DynamicResource VP.Button}" Margin="8" Visibility="{Binding CanLoadMoreHistory, Converter={StaticResource BoolToVis}}"/>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource VP.AccentTextBrush}" Margin="0,0,0,4"><Hyperlink NavigateUri="{Binding SelectedRelease.HtmlUrl}" RequestNavigate="Release_RequestNavigate"><Run Text="{Binding SelectedRelease.Version}"/></Hyperlink></TextBlock>
      <TextBlock Text="{Binding SelectedRelease.PublishedAt}" Foreground="{DynamicResource VP.TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
     </StackPanel>
     <FlowDocumentScrollViewer Grid.Row="1" Document="{Binding SelectedRelease.ReleaseNotes, Converter={StaticResource Markdown}}" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0"/>
     <TextBlock Grid.Row="1" Text="{loc:Loc UpdateHistoryEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}" Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"/>
     <StackPanel Grid.Row="2">
      <StackPanel Margin="0,8,0,0" Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVis}}"><ProgressBar IsIndeterminate="True" Height="3"/><TextBlock Text="{loc:Loc UpdateHistoryLoading}" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Visibility="{Binding HistoryHasError, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
       <TextBlock Text="{loc:Loc UpdateHistoryFailed}" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
       <Button Content="{loc:Loc UpdateRetry}" Command="{Binding RetryHistoryCommand}" Style="{DynamicResource VP.Button}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
