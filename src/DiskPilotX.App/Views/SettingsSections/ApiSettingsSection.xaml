<UserControl x:Class="DiskPilotX.App.Views.SettingsSections.ApiSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
             xmlns:c="clr-namespace:DiskPilotX.App.Converters"
             xmlns:llm="clr-namespace:DiskPilotX.Core.Services.Llm;assembly=DiskPilotX.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource VP.FontFamily}" Loaded="ModelSettings_Loaded" IsVisibleChanged="ModelSettings_IsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToVisibilityConverter x:Key="BoolVis" />
            <c:NullToVisibilityConverter x:Key="NullVis" />
            <Style x:Key="ApiKeyEyeButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="EyeSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeSurface" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EyeSurface" Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource VP.AccentTextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ModelDragHandle" TargetType="Thumb">
                <Setter Property="Width" Value="26"/><Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="SizeAll"/><Setter Property="Focusable" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource VP.TextTertiaryBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                    <Border x:Name="HandleSurface" Background="Transparent" CornerRadius="5">
                        <Path Width="10" Height="16" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Data="M 10,5 A 1,1 0 1 1 8,5 A 1,1 0 1 1 10,5 M 10,12 A 1,1 0 1 1 8,12 A 1,1 0 1 1 10,12 M 10,19 A 1,1 0 1 1 8,19 A 1,1 0 1 1 10,19 M 16,5 A 1,1 0 1 1 14,5 A 1,1 0 1 1 16,5 M 16,12 A 1,1 0 1 1 14,12 A 1,1 0 1 1 16,12 M 16,19 A 1,1 0 1 1 14,19 A 1,1 0 1 1 16,19"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource VP.AccentTextBrush}"/><Setter TargetName="HandleSurface" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HandleSurface" Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}"/><Setter TargetName="HandleSurface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ModelActionButton" TargetType="Button">
                <Setter Property="Width" Value="26"/><Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource VP.TextTertiaryBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource VP.AccentTextBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}"/><Setter TargetName="ActionSurface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="ApiSectionAnchor" Text="{loc:Loc AnthropicApiKeyHeader}"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource VP.TextSecondaryBrush}"
                   Margin="0,0,0,10" />
        <Border x:Name="ApiSection" Background="{DynamicResource VP.SettingsCardBrush}"
                BorderBrush="{DynamicResource VP.BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsBaseUrlLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsBaseUrlHint}" />
                    <TextBox x:Name="BaseUrlInput" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown" Grid.Column="1" Style="{DynamicResource VP.TextBox}"
                             Text="{Binding AnthropicBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsApiFormatLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsApiFormatHint}" />
                    <ComboBox SelectionChanged="ModelConnectionChoice_SelectionChanged" Grid.Column="1"
                              Style="{DynamicResource VP.ComboBox}"
                              ItemsSource="{Binding ApiFormatOptions}"
                              SelectedValue="{Binding SelectedApiFormat}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label" />
                </Grid>
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Key"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc ApiKeyToolTip}" />
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyMaskedInput" Style="{StaticResource ApiPasswordBox}" PasswordChar="*" Padding="10,8,42,8"
                                         PasswordChanged="ApiKeyMaskedInput_PasswordChanged" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown"
                                         AutomationProperties.Name="API Key"/>
                            <TextBox x:Name="ApiKeyInput" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown" Style="{DynamicResource VP.TextBox}"
                                     Visibility="Collapsed" Padding="10,8,42,8" AutomationProperties.Name="API Key"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleButton x:Name="ApiKeyVisibilityToggle" Style="{StaticResource ApiKeyEyeButton}" IsChecked="False"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Grid Width="18" Height="18" IsHitTestVisible="False">
                                    <Path Data="M 1,9 C 4,3 14,3 17,9 C 14,15 4,15 1,9 Z" Stroke="{Binding Foreground, ElementName=ApiKeyVisibilityToggle}" StrokeThickness="1.4"/>
                                    <Ellipse Width="5" Height="5" Stroke="{Binding Foreground, ElementName=ApiKeyVisibilityToggle}" StrokeThickness="1.4"/>
                                    <Path x:Name="ApiKeyEyeSlash" Data="M 2,2 L 16,16" Stroke="{Binding Foreground, ElementName=ApiKeyVisibilityToggle}" StrokeThickness="1.6"/>
                                </Grid>
                            </ToggleButton>
                            <Button Grid.Column="1" Content="{loc:Loc ValidateButton}"
                                    Style="{DynamicResource VP.AccentButton}"
                                    HorizontalAlignment="Right"
                                    Margin="8,0,0,0"
                                    Command="{Binding ValidateCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding ValidationStatusText}"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource VP.TextTertiaryBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValidationState}"
                                                     Value="{x:Static vm:ValidationState.Validating}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ValidationState}"
                                                     Value="{x:Static vm:ValidationState.Valid}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource VP.SuccessTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ValidationState}"
                                                     Value="{x:Static vm:ValidationState.Invalid}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource VP.DangerTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsCliIdentityLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsCliIdentityHint}" />
                    <StackPanel Grid.Column="1">
                        <ComboBox SelectionChanged="ModelConnectionChoice_SelectionChanged" x:Name="CliIdentityPicker" Style="{DynamicResource VP.ComboBox}"
                                  ItemsSource="{Binding CliIdentityOptions}" SelectedValue="{Binding SelectedCliIdentity}" SelectedValuePath="Value"
                                  AutomationProperties.Name="{loc:Loc SettingsCliIdentityLabel}">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate><DataTemplate>
                                <Grid MinWidth="260" ToolTip="{Binding Fingerprint}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Width="26" Height="24" Margin="8,0,0,0"
                                            Command="{Binding RefreshCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanRefresh}"
                                            ToolTip="{Binding RefreshToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc SettingsRefreshCliIdentityHint}"
                                            PreviewMouseLeftButtonDown="CliIdentityRefresh_PreviewMouseLeftButtonDown">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VP.ButtonIcon}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible,RelativeSource={RelativeSource AncestorType=ComboBoxItem},FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Value}" Value="{x:Static llm:CliIdentityKind.None}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CliIdentitySummary}" ToolTip="{Binding CliIdentityFingerprint}" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource VP.TextTertiaryBrush}" Visibility="{Binding CliIdentitySummary,Converter={StaticResource NullVis}}"/>
                    </StackPanel>
                </Grid>
                <Separator Margin="14,0" />
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsProxyModeLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsProxyModeHint}" />
                    <ComboBox SelectionChanged="ModelConnectionChoice_SelectionChanged" Grid.Column="1"
                              Style="{DynamicResource VP.ComboBox}"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ProxyKindOptions}"
                              SelectedValue="{Binding SelectedProxyKind}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label" />
                </Grid>
                <Grid Margin="14,0,14,12"
                      Visibility="{Binding IsCustomProxyConfigurable, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsProxyAddressLabel}"
                               Style="{StaticResource SettingsLabelStyle}"
                               ToolTip="{loc:Loc SettingsProxyAddressHint}" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ProxyHostInput" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown" Style="{DynamicResource VP.TextBox}"
                                     Width="200"
                                      Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc SettingsProxyPortLabel}"
                                       Margin="10,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource VP.TextSecondaryBrush}" />
                            <TextBox x:Name="ProxyPortInput" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown" Style="{DynamicResource VP.TextBox}"
                                     Width="70"
                                     Text="{Binding ProxyPortText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="ProxyUsernameInput" ToolTip="{loc:Loc SettingsProxyUsernameLabel}" AutomationProperties.Name="{loc:Loc SettingsProxyUsernameLabel}" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown" Style="{DynamicResource VP.TextBox}"
                                     Width="130"
                                     Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox x:Name="ProxyPasswordBox" LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown"
                                         Style="{StaticResource ApiPasswordBox}"
                                         Width="200"
                                         Margin="8,0,0,0"
                                         PasswordChanged="ProxyPasswordBox_PasswordChanged"
                                         ToolTip="{loc:Loc SettingsProxyPasswordLabel}"
                                         AutomationProperties.Name="{loc:Loc SettingsProxyPasswordLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Separator Margin="14,0" />
                <Grid x:Name="ModelsUrlRow" Margin="14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc SettingsModelsUrlLabel}" Style="{StaticResource SettingsLabelStyle}"/>
                        <TextBlock x:Name="ModelsUrlHelp" Text="?" Cursor="Help" Margin="6,0,0,0" Width="16" TextAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource VP.TextTertiaryBrush}"
                                   ToolTip="{loc:Loc SettingsModelsUrlHint}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="12000"
                                   AutomationProperties.Name="{loc:Loc SettingsModelsUrlHint}"/>
                    </StackPanel>
                    <TextBox x:Name="ModelsUrlInput" Grid.Column="1" Style="{DynamicResource VP.TextBox}"
                             Text="{Binding ModelsUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SettingsModelsUrlLabel}"
                             LostKeyboardFocus="ModelConnectionEdit_LostKeyboardFocus" PreviewKeyDown="ModelConnectionEdit_PreviewKeyDown"/>
                </Grid>
                <Separator Margin="14,0"/>
                <Grid x:Name="ModelCatalogRow" Margin="14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc SettingsChatModelLabel}" Style="{StaticResource SettingsLabelStyle}"
                               VerticalAlignment="Top" Margin="0,7,0,0"/>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <TextBlock Text="{loc:Loc SettingsModelListEmpty}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextTertiaryBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ModelCandidates.Count}" Value="0"/><Condition Binding="{Binding ModelRefreshMessage}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="ModelOrderScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ModelOrderList" ItemsSource="{Binding ModelCandidates}" AutomationProperties.Name="{loc:Loc SettingsChatModelLabel}">
                                    <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding IsRefreshingModels}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border x:Name="ModelRow" Padding="2,3" Margin="0,1" CornerRadius="6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VP.BorderSubtleBrush}">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Thumb Style="{StaticResource ModelDragHandle}" ToolTip="{loc:Loc SettingsModelDragHint}" AutomationProperties.Name="{loc:Loc SettingsModelDragHint}"
                                                       DragStarted="ModelHandle_DragStarted" DragDelta="ModelHandle_DragDelta" DragCompleted="ModelHandle_DragCompleted" PreviewKeyDown="ModelHandle_PreviewKeyDown"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" ToolTip="{Binding}" Margin="6,0,6,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                                                <Button x:Name="EditModelThinkingButton" Grid.Column="2" Style="{StaticResource ModelActionButton}"
                                                        Tag="{Binding ElementName=ModelRow}" Click="ModelThinkingEdit_Click"
                                                        ToolTip="{loc:Loc SettingsModelThinkingEditHint}" AutomationProperties.Name="{loc:Loc SettingsModelThinkingEditHint}">
                                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 15,4 L 20,9 M 3,16 L 3,21 L 8,21 L 21,8 A 2,2 0 0 0 16,3 Z M 3,16 L 8,21"/>
                                                </Button>
                                                <Button x:Name="RemoveModelButton" Grid.Column="3" Width="26" Height="28"
                                                        Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="{loc:Loc SettingsModelRemoveHint}" AutomationProperties.Name="{loc:Loc SettingsModelRemoveHint}">
                                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModelActionButton}">
                                                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource VP.DangerTextBrush}"/></Trigger></Style.Triggers>
                                                    </Style></Button.Style>
                                                    <Path Width="13" Height="15" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M 10,11 V 17 M 14,11 V 17 M 19,6 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 6 M 3,6 H 21 M 8,6 V 4 A 2,2 0 0 1 10,2 H 14 A 2,2 0 0 1 16,4 V 6"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ModelRow" Property="IsMouseOver" Value="True"><Setter TargetName="EditModelThinkingButton" Property="Opacity" Value="1"/><Setter TargetName="EditModelThinkingButton" Property="IsHitTestVisible" Value="True"/><Setter TargetName="RemoveModelButton" Property="Opacity" Value="1"/><Setter TargetName="RemoveModelButton" Property="IsHitTestVisible" Value="True"/></Trigger>
                                            <Trigger SourceName="ModelRow" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="EditModelThinkingButton" Property="Opacity" Value="1"/><Setter TargetName="EditModelThinkingButton" Property="IsHitTestVisible" Value="True"/><Setter TargetName="RemoveModelButton" Property="Opacity" Value="1"/><Setter TargetName="RemoveModelButton" Property="IsHitTestVisible" Value="True"/></Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <TextBlock Text="{Binding ModelRefreshMessage}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource VP.TextTertiaryBrush}" Visibility="{Binding ModelRefreshMessage,Converter={StaticResource NullVis}}"/>
                    </StackPanel>
                </Grid>
                <Popup x:Name="ModelThinkingPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                    <Border Width="{Binding PlacementTarget.ActualWidth,ElementName=ModelThinkingPopup}" MinWidth="280" MaxWidth="420"
                            Background="{DynamicResource VP.BackgroundAltBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SettingsThinkingLevelLabel}" FontSize="11"
                                       Foreground="{DynamicResource VP.TextTertiaryBrush}" ToolTip="{loc:Loc SettingsThinkingLevelHint}"/>
                            <ComboBox x:Name="ThinkingControlModePicker" Style="{DynamicResource VP.ComboBox}" Margin="0,10,0,2"
                                      Visibility="{Binding IsAnthropicThinking,Converter={StaticResource BoolVis}}"
                                      ItemsSource="{Binding ThinkingControlModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedThinkingControlMode}"
                                      AutomationProperties.Name="{loc:Loc SettingsThinkingControlModeLabel}"/>
                            <ItemsControl x:Name="SupportedThinkingLevels" Margin="0,8,0,0" ItemsSource="{Binding SupportedThinkingLevelOptions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox Style="{DynamicResource VP.CheckBox}" Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,4,14,4" AutomationProperties.Name="{Binding Label}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ThinkingCapabilityHint}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{DynamicResource VP.TextTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
