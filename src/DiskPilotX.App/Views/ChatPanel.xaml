<UserControl x:Class="DiskPilotX.App.Views.ChatPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskPilotX.App.Views" xmlns:c="clr-namespace:DiskPilotX.App.Converters" xmlns:models="clr-namespace:DiskPilotX.Core.Models;assembly=DiskPilotX.Core" xmlns:enums="clr-namespace:DiskPilotX.Core.Enums;assembly=DiskPilotX.Core" xmlns:loc="clr-namespace:DiskPilotX.App.Localization" FontFamily="{DynamicResource VP.FontFamily}">
  <UserControl.Resources>
    <c:BoolToVisibilityConverter x:Key="BoolVis"/><c:NullToVisibilityConverter x:Key="NullVis"/><local:ProcessLabelConverter x:Key="ProcessLabel"/><local:JsonDetailConverter x:Key="JsonDetail"/>
    <CornerRadius x:Key="QuietButtonCornerRadius">8</CornerRadius>
    <Style x:Key="QuietButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource QuietButtonCornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SuggestionPill" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Pill" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource VP.BorderAccentSoftBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource VP.AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
        <ToggleButton PreviewMouseDown="ProcessHeader_PreviewMouseDown" PreviewKeyDown="ProcessHeader_PreviewKeyDown" x:Name="HeaderSite" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Arrow" Text="›" Foreground="{TemplateBinding Foreground}" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/><ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="ProcessBody" ContentSource="Content" Visibility="Collapsed"/>
      </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ProcessBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- ── 沉浸式输入区（LoomX/ZCode 设计语言）────────────────────── -->
    <!-- bare 选择器：透明常态，hover/展开才出浅底；圆角 7；文字三级色 -->
    <Style x:Key="PickerToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource VP.TextTertiaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 弹层：不透明深底 + 极淡描边 + 轻投影，圆角 10 -->
    <Style x:Key="PickerPopupBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource VP.BackgroundAltBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 弹层列表：无框透明，行 hover/选中才出底 -->
    <Style x:Key="PickerList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 发送键：28×28 正圆 Accent 实心，白描边矢量图标（纸飞机/停止） -->
    <Style x:Key="ComposerSendButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Circle" Background="{DynamicResource VP.AccentBrush}" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource VP.AccentHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Circle" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 思考等级滑条：渐变轨道 + 白圆点，快照到 5 档（ZCode 截图样式） -->
    <LinearGradientBrush x:Key="ThinkingSliderGradient" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#30D158" Offset="0"/>
      <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ThinkingSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="4"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{StaticResource ThinkingSliderGradient}"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="#33000000" StrokeThickness="0.5">
                          <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3" Color="#000000"/></Ellipse.Effect>
                        </Ellipse>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate DataType="{x:Type models:ChatSegment}">
      <StackPanel>
        <local:CopilotMarkdownView Markdown="{Binding Text}" Visibility="{Binding IsText,Converter={StaticResource BoolVis}}"/>
        <Expander Expanded="Process_ExpansionChanged" Collapsed="Process_ExpansionChanged" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" Visibility="{Binding IsThinking,Converter={StaticResource BoolVis}}" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="0,3,0,5" BorderThickness="0" Background="Transparent">
          <Expander.Header><TextBlock Text="{loc:Loc ThinkingLabel}" FontSize="12"/></Expander.Header>
          <Border BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="1,0,0,0" Margin="8,5,0,2" Padding="10,0,0,0"><local:ThinkingScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="思考内容"><TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,0,8,0"/></local:ThinkingScrollViewer></Border>
        </Expander>
        <Expander Expanded="Process_ExpansionChanged" Collapsed="Process_ExpansionChanged" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" Visibility="{Binding IsTool,Converter={StaticResource BoolVis}}" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="0,2,0,3" BorderThickness="0" Background="Transparent">
          <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ToolName,Converter={StaticResource ProcessLabel}}" FontSize="12"/><TextBlock Text="{Binding Status,Converter={StaticResource ProcessLabel}}" FontSize="11" Margin="8,0,0,0" Opacity="0.8"/></StackPanel></Expander.Header>
          <Border BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="1,0,0,0" Margin="8,5,0,4" Padding="10,0,0,2"><StackPanel>
            <TextBlock Text="{Binding ToolName}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" Visibility="{Binding HasDetail,Converter={StaticResource BoolVis}}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Text,Mode=OneWay,Converter={StaticResource JsonDetail}}" Visibility="{Binding HasText,Converter={StaticResource BoolVis}}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource VP.TextSecondaryBrush}" FontFamily="Consolas,Microsoft YaHei UI" FontSize="11" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
          </StackPanel></Border>
        </Expander>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Border Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="0.5" CornerRadius="{DynamicResource VP.CardCornerRadius}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="16,11,10,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Copilot" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}"/><TextBlock x:Name="ConversationTitleText" Text="{Binding HeaderText}" Foreground="{DynamicResource VP.TextTertiaryBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="300" AutomationProperties.Name="{Binding HeaderText}"><TextBlock.ToolTip><ToolTip MaxWidth="480" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding HeaderText}" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip></TextBlock></StackPanel>
        <Border Grid.Column="1" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource VP.SurfaceBrush}">
          <Grid x:Name="ConversationButton" Width="40" Height="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
            <Button x:Name="NewConversationButton" Foreground="{DynamicResource VP.TextPrimaryBrush}" Padding="0" Style="{StaticResource QuietButton}" Command="{Binding ClearConversationCommand}" ToolTip="{loc:Loc CopilotNewConversation}" AutomationProperties.Name="{loc:Loc CopilotNewConversation}">
              <Button.Resources><CornerRadius x:Key="QuietButtonCornerRadius">8,0,0,8</CornerRadius></Button.Resources>
              <Path Width="10" Height="10" Data="M5,1 L5,9 M1,5 L9,5" Stretch="None" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Button>
            <Border x:Name="ConversationDivider" Grid.Column="1" Panel.ZIndex="1" Width="1" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{DynamicResource VP.BorderLightBrush}" Opacity="0.55" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
            <Button x:Name="HistoryToggleButton" Grid.Column="1" Foreground="{DynamicResource VP.TextPrimaryBrush}" Padding="0" Style="{StaticResource QuietButton}" Command="{Binding ToggleHistoryCommand}" ToolTip="{loc:Loc CopilotConversationHistory}" AutomationProperties.Name="{loc:Loc CopilotConversationHistory}">
              <Button.Resources><CornerRadius x:Key="QuietButtonCornerRadius">0,8,8,0</CornerRadius></Button.Resources>
              <Path Width="6" Height="4" Data="M1,1 L3,3 L5,1" Stretch="None" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Button>
          </Grid>
        </Border>
        <Popup PlacementTarget="{Binding ElementName=ConversationButton}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsHistoryOpen,Mode=TwoWay}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" PreviewKeyDown="History_KeyDown">
          <Border Width="320" MaxHeight="390" Padding="8" CornerRadius="10" Background="{DynamicResource VP.BackgroundAltBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1">
            <Grid KeyboardNavigation.TabNavigation="Cycle">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="{loc:Loc CopilotConversationHistory}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="8,5,8,10"/>
              <TextBlock Grid.Row="1" Text="{loc:Loc CopilotNoConversationHistory}" FontSize="12" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="8,12,8,18">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasConversationHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <ScrollViewer Grid.Row="1" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasConversationHistory,Converter={StaticResource BoolVis}}" Focusable="False">
                <ItemsControl ItemsSource="{Binding ConversationHistory}"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
                  <Button Command="{Binding DataContext.LoadConversationCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="8,8" Margin="0,1" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Width="266"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource VP.TextPrimaryBrush}"/><TextBlock Text="{Binding UpdatedAtText}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="0,4,0,0"/></StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Popup>
      </Grid>
      <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource VP.SurfaceHoverBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsApiKeyConfigured}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Click="Settings_Click" Content="{loc:Loc OpenSettingsButton}" Style="{StaticResource QuietButton}"/><TextBlock Text="{loc:Loc ChatConfigureApiKey}" Foreground="{DynamicResource VP.TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Messages_ScrollChanged" PreviewMouseDown="Messages_PreviewMouseDown" PreviewMouseWheel="Messages_PreviewMouseWheel" Padding="14,4,14,10">
          <ItemsControl x:Name="MessagesItemsControl" ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Margin="0,5,0,10">
              <Border Padding="12,9" CornerRadius="{DynamicResource VP.CardCornerRadius}" Background="{DynamicResource VP.SurfaceHoverBrush}" HorizontalAlignment="Right" Margin="20,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Sender}" Value="{x:Static enums:ChatSender.User}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextPrimaryBrush}"/></Border>
              <Border Padding="12,8" CornerRadius="{DynamicResource VP.CardCornerRadius}" Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,20,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Sender}" Value="{x:Static enums:ChatSender.System}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Border HorizontalAlignment="Left" Background="{DynamicResource VP.SurfaceActiveBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,0,4"><TextBlock Text="{loc:Loc ChatAppMessageBadge}" FontSize="10" Foreground="{DynamicResource VP.TextSecondaryBrush}"/></Border><TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}"/></StackPanel></Border>
              <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Sender}" Value="{x:Static enums:ChatSender.User}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Sender}" Value="{x:Static enums:ChatSender.System}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Expander IsExpanded="{Binding IsProcessExpanded,Mode=TwoWay}" Visibility="{Binding HasProcess,Converter={StaticResource BoolVis}}" Expanded="Process_ExpansionChanged" Collapsed="Process_ExpansionChanged" Margin="0,2,0,8" Foreground="{DynamicResource VP.TextTertiaryBrush}" AutomationProperties.Name="执行过程">
                  <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ProcessStatus,Converter={StaticResource ProcessLabel},ConverterParameter=process}" FontSize="12"/><TextBlock Text="{Binding DurationText}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                  <ItemsControl ItemsSource="{Binding ProcessSegments}" Margin="10,5,0,0"/>
                </Expander><ItemsControl ItemsSource="{Binding FinalSegments}"/><ItemsControl ItemsSource="{Binding SkillTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" CornerRadius="{DynamicResource VP.CardCornerRadius}" Padding="12" Margin="0,8,0,3"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,10" Foreground="{DynamicResource VP.TextSecondaryBrush}"/><Button Content="打开任务面板" Click="OpenSkillTask_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding OperationResultText}" Visibility="{Binding HasOperationResult,Converter={StaticResource BoolVis}}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource VP.DangerBrush}" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                <TextBlock Text="{Binding DurationText}" Visibility="{Binding HasDuration,Converter={StaticResource BoolVis}}" ToolTip="{Binding CompletedAt,StringFormat=yyyy-MM-dd HH:mm:ss}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding DisplayTime}" ToolTip="{Binding FullTime}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" VerticalAlignment="Center"/>
                <Button Click="Copy_Click" Style="{StaticResource QuietButton}" ToolTip="{loc:Loc CopyMessageToolTip}" AutomationProperties.Name="{loc:Loc CopilotCopy}" Width="28" Height="26" Margin="4,0,0,0" Padding="6">
                  <Path Data="M 8,7 H 19 V 21 H 8 Z M 5,17 H 4 V 3 H 15 V 7" Width="13" Height="14" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,20" VerticalAlignment="Stretch">
          <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
          <StackPanel VerticalAlignment="Center">
            <StackPanel.Resources>
              <CornerRadius x:Key="QuietButtonCornerRadius">10</CornerRadius>
              <Style x:Key="EmptyStatePromptButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                  <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </StackPanel.Resources>
            <TextBlock Text="从一个小问题开始" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,12,0,8"/>
            <TextBlock Text="检查空间，也可以提供参考链接新增扫描规则。" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <Button Content="＋  新增一个新的扫描规则" Command="{Binding ExplorePromptCommand}" CommandParameter="@skill-creator 我想新增一个新的扫描规则，可以提供参考链接或粘贴资料。" Style="{StaticResource EmptyStatePromptButton}" HorizontalContentAlignment="Left" AutomationProperties.Name="新增一个新的扫描规则" ToolTip="可提供参考链接或直接粘贴资料"/>
            <Button Content="查看我的清理规则" Command="{Binding ExplorePromptCommand}" CommandParameter="请列出我现在可以使用的清理规则，区分内置规则和我自己创建的规则，告诉我如何使用。" Style="{StaticResource EmptyStatePromptButton}" HorizontalContentAlignment="Left"/>
            <Button Content="哪些文件占用了空间？" Command="{Binding ExplorePromptCommand}" CommandParameter="帮我检查哪些文件占用了空间。请先让我选择扫描范围，再根据真实扫描结果分析。" Style="{StaticResource EmptyStatePromptButton}" HorizontalContentAlignment="Left"/>
            <TextBlock Text="试试已有规则" FontSize="11" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="10,22,0,8"/>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding CleanupRules}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.ExplorePromptCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Prompt}" Style="{StaticResource EmptyStatePromptButton}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Title}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextPrimaryBrush}"/><TextBlock Grid.Column="1" Text="→" Margin="8,0,0,0" Foreground="{DynamicResource VP.TextTertiaryBrush}"/></Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </ScrollViewer>
        <Button x:Name="JumpButton" Content="{loc:Loc CopilotJumpLatest}" Click="Jump_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8" Background="{DynamicResource VP.SurfaceActiveBrush}" Visibility="Collapsed"/>
      </Grid>
      <Border Grid.Row="3" Margin="12,4" Padding="8" Visibility="{Binding ErrorMessage,Converter={StaticResource NullVis}}" BorderBrush="{DynamicResource VP.DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource VP.ControlCornerRadius}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource VP.TextPrimaryBrush}"/></Border>
      <Border Grid.Row="4" Margin="12,4,12,8" Padding="12" CornerRadius="{DynamicResource VP.CardCornerRadius}" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" Visibility="{Binding HasPendingInteractionCard,Converter={StaticResource BoolVis}}"><StackPanel DataContext="{Binding PendingInteractionCard}">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource VP.TextPrimaryBrush}"/><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0"><TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource VP.TextSecondaryBrush}"/></ScrollViewer><TextBlock Text="{Binding Impact}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,8" Foreground="{DynamicResource VP.TextSecondaryBrush}"/>
        <TextBox Text="{Binding UserNotes,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DataContext.IsUserInputRequested,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolVis}}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxHeight="100" Margin="0,0,0,8" MaxLength="4000"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding CancelText}" Command="{Binding DataContext.CancelInteractionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/><Button Content="{Binding ConfirmText}" Command="{Binding DataContext.ConfirmInteractionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource VP.AccentButton}" Background="{DynamicResource VP.AccentBrush}" Foreground="White" Padding="14,6"/></StackPanel>
      </StackPanel></Border>
      <ContentControl Grid.Row="4" Margin="12,4,12,8" Content="{Binding PendingAskUser}" Visibility="{Binding PendingAskUser,Converter={StaticResource NullVis}}"><ContentControl.ContentTemplate><DataTemplate><local:AskUserCard/></DataTemplate></ContentControl.ContentTemplate></ContentControl>
      <Border x:Name="InputCard" Grid.Row="5" Margin="12,5,12,12" Padding="8,6" CornerRadius="14" Background="{DynamicResource VP.CardBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1"><StackPanel>
        <ListBox x:Name="SkillList" ItemsSource="{Binding FilteredSkillMentionSuggestions}" SelectedItem="{Binding SelectedSkillMentionSuggestion}" Visibility="{Binding IsSkillMentionMenuOpen,Converter={StaticResource BoolVis}}" MaxHeight="130" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource VP.TextPrimaryBrush}" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonUp="Skill_Click"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,3"><TextBlock Text="{Binding DisplayName}" FontSize="12"/><TextBlock Text="{Binding Mention}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <ListBox x:Name="SlashList" ItemsSource="{Binding SlashCommandSuggestions}" SelectedItem="{Binding SelectedSlashCommandSuggestion}" Visibility="{Binding IsSlashCommandMenuOpen,Converter={StaticResource BoolVis}}" MaxHeight="130" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource VP.TextPrimaryBrush}" PreviewMouseLeftButtonUp="Slash_Click"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,3"><TextBlock Text="{Binding Command}" FontSize="12"/><TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Grid Visibility="{Binding LinkedItemPath,Converter={StaticResource NullVis}}" Margin="2,0,2,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LinkedItemPath}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource VP.TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="{Binding LinkedItemPath}"/><Button Grid.Column="1" Content="×" Command="{Binding UnlinkItemCommand}" Style="{StaticResource QuietButton}" ToolTip="{loc:Loc ClearContextToolTip}"/></Grid>
        <Grid><TextBox x:Name="InputTextBox" Text="{Binding InputText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" MaxHeight="160" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="6,6" FontSize="13" Foreground="{DynamicResource VP.TextPrimaryBrush}" PreviewKeyDown="Input_KeyDown" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus" AutomationProperties.Name="{loc:Loc CopilotInputLabel}"/><TextBlock Text="{loc:Loc CopilotPlaceholder}" IsHitTestVisible="False" Margin="8,8" FontSize="12" Foreground="{DynamicResource VP.TextTertiaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <!-- 底部控件行：@ 技能 | 模型+思考等级（合并选择器） | 发送。bare 选择器沉浸于卡片，hover 才出底。 -->
        <Grid Margin="2,3,2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="@" Click="Skills_Click" Style="{StaticResource QuietButton}" ToolTip="{loc:Loc CopilotChooseSkill}" FontSize="14" Padding="7,3"/>
          <!-- 合并选择器（ZCode 样式）：模型名 + 思考等级 + ▾，一个控件，点开弹层 -->
          <ToggleButton x:Name="ModelPickerToggle" Grid.Column="1" Style="{StaticResource PickerToggle}" ToolTip="{loc:Loc CopilotModelSelectorLabel}" AutomationProperties.Name="{loc:Loc CopilotModelSelectorLabel}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ModelDisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ThinkingPickerLabel}" Margin="6,0,0,0" Opacity="0.85" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked,ElementName=ModelPickerToggle,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Top" PlacementTarget="{Binding ElementName=ModelPickerToggle}" VerticalOffset="-4">
            <Border Style="{StaticResource PickerPopupBorder}" Width="272">
              <StackPanel>
                <TextBlock Text="{loc:Loc ComposerModelsSectionLabel}" FontSize="10" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="9,6,0,4"/>
                <TextBlock Text="{loc:Loc SettingsModelListEmpty}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource VP.TextTertiaryBrush}" Margin="9,4,9,8">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ModelCandidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="ModelList" Style="{StaticResource PickerList}" ItemsSource="{Binding ModelCandidates}" SelectedItem="{Binding SelectedChatModel}" MaxHeight="196" SelectionChanged="ModelList_SelectionChanged"/>
                <!-- 思考等级：弹层底部分隔线下方，渐变滑条（LoomX foldout 配方 + ZCode 交互） -->
                <Border BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="6,8,6,2">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{loc:Loc CopilotThinkingSelectorLabel}" FontSize="11" Foreground="{DynamicResource VP.TextTertiaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding ThinkingPickerLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VP.AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider x:Name="ThinkingSlider" Style="{StaticResource ThinkingSlider}" Margin="3,9,3,4" ValueChanged="ThinkingSlider_ValueChanged" Value="{Binding SelectedThinkingLevelIndex,Mode=OneWay}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Popup>
          <Button Grid.Column="4" Click="Submit_Click" Command="{Binding SubmitOrStopCommand}" Style="{StaticResource ComposerSendButton}" ToolTip="{Binding SendButtonText}" AutomationProperties.Name="{Binding SendButtonText}">
            <Grid>
              <Path Data="M 21,3 L 10.5,13.5 M 21,3 L 14.5,21 L 10.5,13.5 M 10.5,13.5 L 3,10.2 L 21,3" Width="13" Height="13" Stretch="None" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
              </Path>
              <Path Data="M 8.5,8.5 H 15.5 V 15.5 H 8.5 Z" Width="12" Height="12" Stretch="None" Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
              </Path>
            </Grid>
          </Button>
        </Grid>
      </StackPanel></Border>
    </Grid>
  </Border>
</UserControl>
