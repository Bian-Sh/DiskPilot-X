<Window x:Class="DiskPilotX.App.Views.UninstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
        FontFamily="{DynamicResource VP.FontFamily}"
        Title="确认卸载" Width="600"
        SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowActivated="True"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 与宿主主窗口同构：无系统标题栏；圆角、裁切、磨砂材质统一交给 HostWindowChrome -->
  <Border x:Name="Frame" BorderThickness="1"
          Background="{DynamicResource VP.BackgroundAltBrush}"
          BorderBrush="{DynamicResource VP.DangerBrush}"
          CornerRadius="{DynamicResource VP.WindowCornerRadius}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <controls:WindowTitleBar x:Name="HostTitleBar" Grid.Row="0" ApplicationToolsVisibility="Collapsed"/>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,10,28,22">
        <StackPanel>
          <!-- 危险标识：一屏之内先让人看出这不是普通确认 -->
          <Border Background="{DynamicResource VP.DangerBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="危险操作 · 卸载后无法在 DiskPilot-X 里撤销" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="这一步会调用 Steam 的原生卸载把游戏从本机移除，确认后流程由 Steam 接管。" FontSize="11.5" Foreground="White" Opacity="0.92" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SourceLine}" FontSize="11.5" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,4,0,0"/>

          <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="10"
                  Background="{DynamicResource VP.SurfaceBrush}" BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="占用空间" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,0,14,6"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="应用编号" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,0,14,6"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppId}" FontSize="12" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="安装目录" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,0,14,0"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallPath}" FontSize="12" Foreground="{DynamicResource VP.TextPrimaryBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>

          <TextBlock Text="确认前请读一遍：" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource VP.TextPrimaryBrush}" Margin="0,18,0,8"/>
          <TextBlock Text="· Steam 会删除本机上的全部游戏文件，这台机器上再次玩需要重新下载。"
                     FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,0,0,5"/>
          <TextBlock Text="· 开启了 Steam 云存档的游戏，云端进度通常会保留；没开云的本地存档可能一起删除。"
                     FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,0,0,5"/>
          <TextBlock Text="· DiskPilot-X 只负责发出卸载指令，实际的删除由 Steam 完成；过程中请不要强制结束 Steam。"
                     FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,0,0,5"/>
          <TextBlock Text="· 创意工坊内容、模组与截图目录的处理由 Steam 决定，可能留有残余。"
                     FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" TextWrapping="Wrap" Margin="12,0,0,0"/>

          <!-- 必须显式确认：不允许一路回车点到卸载 -->
          <CheckBox x:Name="Acknowledge" Margin="0,18,0,0" FontSize="12.5" Foreground="{DynamicResource VP.TextPrimaryBrush}"
                    IsChecked="{Binding Acknowledged, Mode=TwoWay}">
            <TextBlock Text="{Binding AcknowledgeText}" TextWrapping="Wrap" Margin="6,-1,0,0"/>
          </CheckBox>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="取消不会做任何改动。" FontSize="11" Foreground="{DynamicResource VP.TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,10,0"
                    Style="{DynamicResource VP.Button}"/>
            <Button Grid.Column="2" x:Name="ConfirmButton" Content="{Binding ConfirmLabel}" Click="Confirm_Click"
                    Style="{DynamicResource VP.DangerButton}" FontWeight="SemiBold"
                    IsEnabled="{Binding Acknowledged}"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
