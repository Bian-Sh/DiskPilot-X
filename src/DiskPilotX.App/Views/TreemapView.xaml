<UserControl x:Class="DiskPilotX.App.Views.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 只补树图深度入口的子菜单宿主，不改控制台的通用MenuItem模板。 -->
        <Style x:Key="TreemapDepthMenu" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Highlight" Background="Transparent" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" Margin="4,0" />
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource VP.BackgroundAltBrush}"
                                        BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="0.5"
                                        CornerRadius="8" Padding="4,2" Margin="4">
                                    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid>
        <!-- Treemap area: rounded container with clip -->
        <Border x:Name="TreemapContainer"
                Background="{DynamicResource VP.SurfaceBrush}"
                CornerRadius="0,0,10,10"
                ClipToBounds="True"
                SizeChanged="TreemapContainer_SizeChanged"
                BorderBrush="{DynamicResource VP.BorderLightBrush}"
                BorderThickness="0.5,0,0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.3"
                                  Direction="270" />
            </Border.Effect>
            <Grid>
                <controls:TreemapControl x:Name="Treemap"
                                         NodeClicked="Treemap_NodeClicked"
                                         NodeActivated="Treemap_NodeActivated"
                                         NodeHovered="Treemap_NodeHovered"
                                         NodeRightClicked="Treemap_NodeRightClicked"
                                         SizeChanged="Treemap_SizeChanged" />

                <!-- 多选提示不接管指针，也不改变地图的可视预算。 -->
                <Border x:Name="SelectionBadge" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Padding="10,6" CornerRadius="6" Background="{DynamicResource VP.BackgroundAltBrush}">
                    <TextBlock x:Name="SelectionBadgeText" Foreground="{DynamicResource VP.TextPrimaryBrush}" FontSize="12" />
                </Border>

                <!-- Empty state: text overlay on canvas, no background panel -->
                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Visible">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               Foreground="{DynamicResource VP.TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="{loc:Loc TreemapEmptyTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VP.TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateHint"
                               Text="{loc:Loc TreemapEmptyHint}"
                               FontSize="13"
                               Foreground="{DynamicResource VP.TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- Scanning overlay -->
                <Border x:Name="ScanningOverlay"
                        Background="{DynamicResource VP.OverlayBrush}"
                        CornerRadius="0,0,10,10"
                        Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScanTitleText"
                                   Text="{loc:Loc ScanningStatus}"
                                   FontSize="24"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource VP.TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ScanProgressText"
                                   FontSize="14"
                                   Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="ScanDecisionText" TextWrapping="Wrap" MaxWidth="620"
                                   FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="20,10,20,0"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button Content="{loc:Loc CancelButton}"
                                Padding="20,8"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding DataContext.CancelScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{loc:Loc CancelScanToolTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource VP.Button}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsExternalScan, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
