<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiskPilotX.App.Controls">

    <!-- ═══════════════════════════════════════════════════════════════
         磁盘工作区与 Copilot 共用的主题语义
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Colors ──────────────────────────────────────────────────── -->
    <!-- 全部窗口和动态面板共用的形状资源。 -->
    <CornerRadius x:Key="VP.WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="VP.CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="VP.CardTopCornerRadius">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="VP.CardBottomCornerRadius">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="VP.ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="VP.SmallCornerRadius">4</CornerRadius>

    <Color x:Key="VP.Background">#0D121A</Color>
    <Color x:Key="VP.BackgroundTint">#0D121A</Color>
    <Color x:Key="VP.Overlay">#80484853</Color>
    <Color x:Key="VP.BackgroundAlt">#18202D</Color>
    <Color x:Key="VP.Surface">#1AFFFFFF</Color>          <!-- 10% white over slate background -->
    <Color x:Key="VP.SurfaceHover">#22FFFFFF</Color>     <!-- 13% white -->
    <Color x:Key="VP.SurfaceActive">#2BFFFFFF</Color>    <!-- 17% white -->
    <Color x:Key="VP.SettingsCard">#1EFFFFFF</Color>     <!-- 12% white -->
    <Color x:Key="VP.Card">#12FFFFFF</Color>             <!-- 7% white — recommendation cards -->
    <Color x:Key="VP.BorderLight">#2FFFFFFF</Color>      <!-- 19% white -->
    <Color x:Key="VP.BorderSubtle">#20FFFFFF</Color>     <!-- 13% white -->
    <Color x:Key="VP.BorderAccentSoft">#663B82F6</Color> <!-- 40% accent — 输入卡聚焦描边（LoomX AccentBorderSoft 同款） -->

    <Color x:Key="VP.TextPrimary">#FFFFFF</Color>
    <Color x:Key="VP.TextSecondary">#9AA8BC</Color>
    <Color x:Key="VP.TextTertiary">#8796AB</Color>
    <Color x:Key="VP.Accent">#2563EB</Color>
    <Color x:Key="VP.AccentHover">#3B82F6</Color>
    <Color x:Key="VP.Danger">#FF453A</Color>
    <Color x:Key="VP.DangerPressed">#CC1A1A</Color>
    <Color x:Key="VP.Success">#30D158</Color>
    <Color x:Key="VP.Warning">#FFD60A</Color>

    <Color x:Key="VP.AccentText">#6A9AFF</Color>
    <Color x:Key="VP.AccentHoverText">#7BAAFF</Color>
    <Color x:Key="VP.SuccessText">#30D158</Color>
    <Color x:Key="VP.WarningText">#FFD60A</Color>
    <Color x:Key="VP.DangerText">#FF453A</Color>
    <Color x:Key="VP.ModalWarningHeader">#86714F</Color>
    <Color x:Key="VP.ModalDangerHeader">#BB2124</Color>
    <Color x:Key="VP.ModalNormalHeader">#62686E</Color>

    <!-- ── Brushes ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="VP.BackgroundBrush" Color="{DynamicResource VP.BackgroundTint}" />
    <SolidColorBrush x:Key="VP.BackgroundAltBrush" Color="{DynamicResource VP.BackgroundAlt}" />
    <!-- 动态窗口可在局部覆写材质底板，未注册时安全使用实色主题底。 -->
    <SolidColorBrush x:Key="VP.SkillWindowSurfaceBrush" Color="{DynamicResource VP.BackgroundAlt}" />
    <SolidColorBrush x:Key="VP.SurfaceBrush" Color="{DynamicResource VP.Surface}" />
    <SolidColorBrush x:Key="VP.SurfaceHoverBrush" Color="{DynamicResource VP.SurfaceHover}" />
    <SolidColorBrush x:Key="VP.SurfaceActiveBrush" Color="{DynamicResource VP.SurfaceActive}" />
    <SolidColorBrush x:Key="VP.SettingsCardBrush" Color="{DynamicResource VP.SettingsCard}" />
    <SolidColorBrush x:Key="VP.CardBrush" Color="{DynamicResource VP.Card}" />
    <SolidColorBrush x:Key="VP.BorderLightBrush" Color="{DynamicResource VP.BorderLight}" />
    <SolidColorBrush x:Key="VP.BorderSubtleBrush" Color="{DynamicResource VP.BorderSubtle}" />
    <SolidColorBrush x:Key="VP.BorderAccentSoftBrush" Color="{DynamicResource VP.BorderAccentSoft}" />
    <SolidColorBrush x:Key="VP.TextPrimaryBrush" Color="{DynamicResource VP.TextPrimary}" />
    <SolidColorBrush x:Key="VP.TextSecondaryBrush" Color="{DynamicResource VP.TextSecondary}" />
    <SolidColorBrush x:Key="VP.TextTertiaryBrush" Color="{DynamicResource VP.TextTertiary}" />
    <SolidColorBrush x:Key="VP.AccentBrush" Color="{DynamicResource VP.Accent}" />
    <SolidColorBrush x:Key="VP.AccentHoverBrush" Color="{DynamicResource VP.AccentHover}" />
    <SolidColorBrush x:Key="VP.DangerBrush" Color="{DynamicResource VP.Danger}" />
    <SolidColorBrush x:Key="VP.DangerPressedBrush" Color="{DynamicResource VP.DangerPressed}" />
    <SolidColorBrush x:Key="VP.SuccessBrush" Color="{DynamicResource VP.Success}" />
    <SolidColorBrush x:Key="VP.WarningBrush" Color="{DynamicResource VP.Warning}" />
    <SolidColorBrush x:Key="VP.OverlayBrush" Color="{DynamicResource VP.Overlay}" />

    <SolidColorBrush x:Key="VP.AccentTextBrush" Color="{DynamicResource VP.AccentText}" />
    <SolidColorBrush x:Key="VP.AccentHoverTextBrush" Color="{DynamicResource VP.AccentHoverText}" />
    <SolidColorBrush x:Key="VP.SuccessTextBrush" Color="{DynamicResource VP.SuccessText}" />
    <SolidColorBrush x:Key="VP.WarningTextBrush" Color="{DynamicResource VP.WarningText}" />
    <SolidColorBrush x:Key="VP.DangerTextBrush" Color="{DynamicResource VP.DangerText}" />
    <SolidColorBrush x:Key="VP.ModalWarningHeaderBrush" Color="{DynamicResource VP.ModalWarningHeader}" />
    <SolidColorBrush x:Key="VP.ModalDangerHeaderBrush" Color="{DynamicResource VP.ModalDangerHeader}" />
    <SolidColorBrush x:Key="VP.ModalNormalHeaderBrush" Color="{DynamicResource VP.ModalNormalHeader}" />

    <!-- ── Typography ──────────────────────────────────────────────── -->
    <FontFamily x:Key="VP.FontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════
         Reusable Styles
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Glass Panel ─────────────────────────────────────────────── -->
    <Style x:Key="VP.GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource VP.CardCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ── Breadcrumb Button (address bar segments) ───────────────── -->
    <!-- Matches title-bar hover behavior but uses rounded corners for the
         hover/highlight background so breadcrumb segments feel less
         visually abrupt. -->
    <Style x:Key="VP.BreadcrumbButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VP.GlassPanelLarge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource VP.CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ── Button (Default) ────────────────────────────────────────── -->
    <ControlTemplate x:Key="VP.ButtonTemplate" TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
    <Style x:Key="VP.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{DynamicResource VP.ButtonTemplate}" />
    </Style>

    <!-- ── Button (Accent / Primary) ───────────────────────────────── -->
    <Style x:Key="VP.AccentButton" TargetType="Button" BasedOn="{StaticResource VP.Button}">
        <Setter Property="Background" Value="{DynamicResource VP.AccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Button (Danger) ─────────────────────────────────────────── -->
    <Style x:Key="VP.DangerButton" TargetType="Button" BasedOn="{StaticResource VP.Button}">
        <Setter Property="Background" Value="{DynamicResource VP.DangerBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ── Button (Transparent Icon — toolbar nav) ────────────────── -->
    <Style x:Key="VP.ButtonIcon" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}" Padding="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource VP.TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource VP.TextTertiaryBrush}" />
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Title Bar Button (Min/Max) ──────────────────────────────── -->
    <Style x:Key="VP.TitleBarButton" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource VP.TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Title Bar Close Button ──────────────────────────────────── -->
    <Style x:Key="VP.TitleBarCloseButton" TargetType="Button"
           BasedOn="{StaticResource VP.TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="0,8,0,0" Padding="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.DangerBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TextBox ─────────────────────────────────────────────────── -->
    <ControlTemplate x:Key="VP.TextBoxTemplate" TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0.5"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource VP.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
    <Style x:Key="VP.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SelectionBrush" Value="{DynamicResource VP.AccentBrush}" />
        <Setter Property="Template" Value="{DynamicResource VP.TextBoxTemplate}" />
    </Style>

    <!-- ── ComboBox ────────────────────────────────────────────────── -->
    <Style x:Key="VP.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource VP.ControlCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>

                                <!-- Selected item display -->
                                <ContentPresenter x:Name="ContentSite"
                                    Grid.Column="0"
                                    IsHitTestVisible="False"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left" />

                                <!-- Editable text (when IsEditable=true) -->
                                <TextBox x:Name="PART_EditableTextBox"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Foreground="{TemplateBinding Foreground}"
                                    CaretBrush="{DynamicResource VP.TextPrimaryBrush}"
                                    BorderThickness="0"
                                    IsReadOnly="{TemplateBinding IsReadOnly}"
                                    Visibility="Hidden"
                                    Focusable="True" />

                                <!-- Dropdown arrow -->
                                <TextBlock Grid.Column="1"
                                    Text="&#xE70D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                                <!-- Toggle button (invisible, covers whole control) -->
                                <ToggleButton Grid.ColumnSpan="2"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Focusable="False"
                                    IsTabStop="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="PART_Popup"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=Bd}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{DynamicResource VP.BackgroundAltBrush}"
                                BorderBrush="{DynamicResource VP.BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                                Padding="4"
                                Margin="0,2,0,0">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <VirtualizingStackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBoxItem (dark theme) ─────────────────────────────── -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox (dark themed) ───────────────────────────────────── -->
    <Style x:Key="VP.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,0,8,0">
                            <Border x:Name="CheckBorder"
                                    Background="{DynamicResource VP.SurfaceBrush}"
                                    BorderBrush="{DynamicResource VP.BorderLightBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="{DynamicResource VP.SmallCornerRadius}" />
                            <Path x:Name="CheckMark"
                                  Data="M 3,9 L 7,13 L 15,4"
                                  Stroke="{DynamicResource VP.AccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <Rectangle x:Name="IndeterminateMark"
                                       Width="10"
                                       Height="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{DynamicResource VP.AccentBrush}"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource VP.AccentHoverBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource VP.TextPrimaryBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource VP.AccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="IndeterminateMark" Property="Fill" Value="{DynamicResource VP.TextPrimaryBrush}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource VP.AccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Tab Button (Chrome-style: border, no bg) ─────────────────── -->
    <Style x:Key="VP.TabButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0.5,0.5,0.5,0"
                            CornerRadius="{DynamicResource VP.CardTopCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,-0.5,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource VP.BorderLightBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource VP.TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource VP.TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── GridSplitter (subtle) ───────────────────────────────────── -->
    <Style x:Key="VP.GridSplitterH" TargetType="GridSplitter">
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource VP.BorderSubtleBrush}" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="ResizeDirection" Value="Rows" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Cursor" Value="SizeNS" />
    </Style>

    <Style x:Key="VP.GridSplitterV" TargetType="GridSplitter">
        <Setter Property="Width" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource VP.BorderSubtleBrush}" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Cursor" Value="SizeWE" />
    </Style>

    <!-- ── ScrollBar (minimal dark) ────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource VP.BorderLightBrush}"
                                                    CornerRadius="{DynamicResource VP.SmallCornerRadius}"
                                                    Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource VP.BorderLightBrush}"
                                                            CornerRadius="{DynamicResource VP.SmallCornerRadius}"
                                                            Margin="0,1" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Focus Visual Style (accent outline) ─────────────────────── -->
    <Style x:Key="VP.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource VP.AccentBrush}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True"
                               RadiusX="4" RadiusY="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ListView / ListViewItem (dark theme) ────────────────────── -->
    <Style x:Key="VP.ListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
    </Style>

    <Style x:Key="VP.ListViewItem" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── GroupBox (dark themed) ──────────────────────────────────── -->
    <Style x:Key="VP.GroupBox" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ── ToolTip (dark glass) ────────────────────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource VP.BackgroundAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ── ContextMenu (dark glass, full custom template) ──────────────── -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource VP.BackgroundAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Margin="8"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="16"
                                              Opacity="0.5" Color="Black"
                                              Direction="270" />
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      MaxHeight="{TemplateBinding MaxHeight}">
                            <VirtualizingStackPanel IsItemsHost="True"
                                        Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── MenuItem (dark, custom check + hover) ──────────────────────── -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" SharedSizeGroup="CheckCol" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutCol" />
                            </Grid.ColumnDefinitions>

                            <!-- Custom checkmark -->
                            <TextBlock x:Name="CheckMark"
                                       Grid.Column="0"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource VP.AccentTextBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed" />

                            <!-- Header text -->
                            <ContentPresenter x:Name="HeaderHost"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="4,0" />

                            <!-- Input gesture / shortcut text -->
                            <TextBlock x:Name="InputGestureText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource VP.TextTertiaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource VP.SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <!-- Reserve check column space even when unchecked -->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Separator (clean line) ────────────────────────────────────── -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource VP.BorderSubtleBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}"
                            Height="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="VP.WarningSurfaceBrush" Color="{DynamicResource VP.Warning}" Opacity="0.12" />

    <!-- 动态任务表格复用同一组画刷，表头和选中态也随主题更新。 -->
    <Style x:Key="VP.DataGridText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="VP.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="VP.DataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="VP.DataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource VP.SurfaceActiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="VP.DataGrid" TargetType="DataGrid">
        <Setter Property="controls:NestedScrollWheel.Enabled" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource VP.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource VP.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource VP.BorderSubtleBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource VP.DataGridColumnHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource VP.DataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource VP.DataGridCell}" />
    </Style>
    <!-- 通用表格只默认接入滚轮规则，不覆盖业务表格的外观。 -->
    <Style TargetType="DataGrid"><Setter Property="controls:NestedScrollWheel.Enabled" Value="True" /></Style>
</ResourceDictionary>
