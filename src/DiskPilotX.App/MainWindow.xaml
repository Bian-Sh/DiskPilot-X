<Window x:Class="DiskPilotX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskPilotX.App"
        xmlns:vm="clr-namespace:DiskPilotX.App.ViewModels"
        xmlns:views="clr-namespace:DiskPilotX.App.Views"
        xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
        xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{loc:Loc AppTitle}"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource VP.FontFamily}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 控制台右键菜单：清空日志 -->
        <ContextMenu x:Key="ConsoleContextMenu">
            <MenuItem Header="{loc:Loc ConsoleClearMenuItem}" Click="ConsoleClearMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource VP.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />  <!-- Title bar -->
            <RowDefinition Height="*" />   <!-- Content -->
        </Grid.RowDefinitions>

        <!-- 鈺愨晲鈺?Custom Title Bar 鈺愨晲鈺?-->
        <controls:WindowTitleBar x:Name="TitleBar"
                                 Grid.Row="0"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />

        <!-- 鈺愨晲鈺?Main Content 鈺愨晲鈺?-->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Toolbar -->
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />       <!-- Central content -->
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />    <!-- Status bar -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ChatPanelColumn" Width="360" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 鈺愨晲鈺?Toolbar (aligned with treemap, not chat panel) 鈺愨晲鈺?-->
            <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource VP.GlassPanel}" Padding="8,6">
                <DockPanel LastChildFill="True">

                    <!-- Left: navigation buttons (transparent, hover glow) -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Width="32" Height="32"
                                Style="{DynamicResource VP.ButtonIcon}"
                                Click="BackButton_Click"
                                ToolTip="{loc:Loc NavigateBackToolTip}">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="ForwardButton"
                                Width="32" Height="32"
                                Style="{DynamicResource VP.ButtonIcon}"
                                Click="ForwardButton_Click"
                                IsEnabled="False"
                                ToolTip="{loc:Loc NavigateForwardToolTip}">
                            <TextBlock Text="&#xE72A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button x:Name="UpButton"
                                Width="32" Height="32"
                                Margin="2,0,6,0"
                                Style="{DynamicResource VP.ButtonIcon}"
                                Click="UpButton_Click"
                                IsEnabled="False"
                                ToolTip="{loc:Loc NavigateUpToolTip}">
                            <TextBlock Text="&#xE74A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                    </StackPanel>


                    <Button x:Name="ScanButton"
                            DockPanel.Dock="Right"
                            Content="{loc:Loc ScanButton}"
                            Style="{DynamicResource VP.AccentButton}"
                            Padding="16,5"
                            FontSize="12"
                            Margin="0,0,4,0"
                            Command="{Binding ScanCommand}"
                            PreviewMouseLeftButtonDown="ScanButton_PreviewMouseLeftButtonDown"
                            Click="ScanButton_Click"
                            >
                        <Button.ToolTip>
                            <StackPanel MaxWidth="540">
                                <TextBlock Text="{loc:Loc ScanButtonToolTip}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScanDecisionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>

                    <!-- Address bar: LAST child fills remaining space between nav and action buttons -->
                    <Border x:Name="AddressBarBorder"
                            DockPanel.Dock="Left"
                            Background="{DynamicResource VP.SurfaceBrush}"
                            BorderBrush="{DynamicResource VP.BorderLightBrush}"
                            BorderThickness="0.5"
                            CornerRadius="{DynamicResource VP.ControlCornerRadius}"
                            Padding="0"
                            Margin="0,0,4,0"
                            MinWidth="120"
                            Height="32"
                            MouseLeftButtonUp="AddressBar_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Breadcrumb display (visible by default) -->
                            <StackPanel x:Name="BreadcrumbBar"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="8,5,4,5"
                                        Visibility="Visible" />

                            <!-- Text edit mode (hidden by default) -->
                            <TextBox x:Name="PathEditTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource VP.TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource VP.TextPrimaryBrush}"
                                     BorderThickness="0"
                                     Padding="8,5"
                                     FontSize="13"
                                     FontFamily="{DynamicResource VP.FontFamily}"
                                     KeyDown="PathEditTextBox_KeyDown"
                                     LostFocus="PathEditTextBox_LostFocus"
                                     Visibility="Collapsed"
                                     ToolTip="{loc:Loc PathSelectorToolTip}" />

                            <!-- Folder picker icon inside address bar, right-aligned -->
                            <Button x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Width="32" Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding BrowseCommand}"
                                    ToolTip="{loc:Loc BrowseButtonToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Ico"
                                                       Text="&#xE838;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ico" Property="Foreground"
                                                        Value="{DynamicResource VP.TextPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Ico" Property="Foreground"
                                                        Value="{DynamicResource VP.AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Grid x:Name="ContentGrid" Grid.Row="2" Grid.Column="0" SizeChanged="ContentGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="RecommendationsPanelRow" Height="340" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!-- View mode tab bar (Treemap / TreeView) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource VP.SurfaceBrush}"
                            CornerRadius="{DynamicResource VP.CardTopCornerRadius}"
                            Margin="0,0,0,-0.5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TreemapTabBtn"
                                         Content="{loc:Loc TreemapTabHeader}"
                                         Style="{DynamicResource VP.TabButton}"
                                         IsChecked="True"
                                         Checked="TreemapTab_Checked"
                                         GroupName="ViewModeTabs" />
                            <RadioButton x:Name="TreeViewTabBtn"
                                         Content="{loc:Loc TreeViewTabHeader}"
                                         Style="{DynamicResource VP.TabButton}"
                                         Checked="TreeViewTab_Checked"
                                         GroupName="ViewModeTabs" />
                            <RadioButton x:Name="AboutTabBtn"
                                         Content="{loc:Loc AboutTabHeader}"
                                         Style="{DynamicResource VP.TabButton}"
                                         Checked="AboutTab_Checked"
                                         GroupName="ViewModeTabs" />
                        </StackPanel>
                    </Border>

                    <!-- Treemap view -->
                    <views:TreemapView x:Name="TreemapView" Grid.Row="1" />

                    <!-- TreeView (hidden by default) -->
                    <views:TreeViewControl x:Name="TreeViewControl" Grid.Row="1" Visibility="Collapsed" />

                    <!-- About page (hidden by default) -->
                    <views:AboutPage x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed" />

                    <!-- Subtle splitter -->
                    <GridSplitter x:Name="RecommendationsSplitter"
                                  Grid.Row="2"
                                  Style="{DynamicResource VP.GridSplitterH}"
                                  Margin="8,4"
                                  ShowsPreview="False"
                                  Visibility="Visible" />

                    <!-- Bottom tool window: Chrome-style tabs + content -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab bar (outside container border, Chrome-style) -->
                        <Border x:Name="BottomTabBar"
                                Grid.Row="0"
                                Background="{DynamicResource VP.SurfaceBrush}"
                                CornerRadius="{DynamicResource VP.CardTopCornerRadius}"
                                Margin="0,0,0,-0.5">
                        <DockPanel>

                            <!-- Console filter (docked right, only visible when console tab is active) -->
                            <Button x:Name="ConsoleFilterButton"
                                    DockPanel.Dock="Right"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Width="28" Height="28"
                                    Padding="0"
                                    Margin="4,0"
                                    Visibility="Collapsed"
                                    ToolTip="{loc:Loc ConsoleFilterToolTip}"
                                    AutomationProperties.Name="{loc:Loc ConsoleFilterToolTip}"
                                    Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ConsoleFilterButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="{DynamicResource VP.ControlCornerRadius}" Padding="0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource VP.SurfaceHoverBrush}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource VP.TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="&#xE712;"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="ConsoleLevelVerboseMenuItem" Header="Verbose" IsCheckable="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <MenuItem x:Name="ConsoleLevelDebugMenuItem" Header="Debug" IsCheckable="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <MenuItem x:Name="ConsoleLevelInfoMenuItem" Header="Info" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <MenuItem x:Name="ConsoleLevelWarningMenuItem" Header="Warning" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <MenuItem x:Name="ConsoleLevelErrorMenuItem" Header="Error" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <MenuItem x:Name="ConsoleLevelFatalMenuItem" Header="Fatal" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="LogLevelFilter_Click" />
                                        <Separator />
                                        <MenuItem x:Name="ConsoleOpenLogsMenuItem" Header="{loc:Loc ConsoleOpenLogsToolTip}" Click="ConsoleOpenLogs_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Tab buttons (flush left, Chrome-style) -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RecommendationsTabBtn"
                                             Content="{loc:Loc RecommendationsTabHeader}"
                                             Style="{DynamicResource VP.TabButton}"
                                             IsChecked="True"
                                             Checked="RecommendationsTab_Checked"
                                             GroupName="BottomTabs" />
                                <RadioButton x:Name="ConsoleTabBtn"
                                             Content="{loc:Loc ConsoleTabHeader}"
                                             Style="{DynamicResource VP.TabButton}"
                                             Checked="ConsoleTab_Checked"
                                             GroupName="BottomTabs" />
                            </StackPanel>
                        </DockPanel>
                        </Border>

                        <!-- Content area (border connects to active tab) -->
                        <Grid Grid.Row="1">
                            <!-- 投影只保留在面板外侧，避免透过半透明底板降低文字对比度。 -->
                            <Grid x:Name="BottomPanelShadow" IsHitTestVisible="False"
                                  SizeChanged="BottomPanelShadow_SizeChanged">
                                <Border Background="{DynamicResource VP.SurfaceBrush}"
                                        CornerRadius="{DynamicResource VP.CardBottomCornerRadius}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2"
                                                          Opacity="0.3" Direction="270" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="BottomPanelSurface"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource VP.SurfaceBrush}"
                                    BorderBrush="{DynamicResource VP.BorderLightBrush}"
                                    BorderThickness="0.5,0,0.5,0.5"
                                    CornerRadius="{DynamicResource VP.CardBottomCornerRadius}" />
                            <Grid x:Name="BottomContentGrid" Margin="0.5,0,0.5,0.5" MinHeight="120">
                                <!-- Recommendations panel content -->
                                <views:RecommendationsPanel x:Name="RecommendationsPanel"
                                                            Visibility="Visible" />

                                <!-- Console panel content -->
                                <Border x:Name="ConsoleFrame"
                                        Margin="4,0,4,4"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource VP.CardBottomCornerRadius}"
                                        ClipToBounds="True"
                                        ContextMenu="{StaticResource ConsoleContextMenu}"
                                        IsVisibleChanged="ConsoleFrame_IsVisibleChanged"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="12,6,12,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid x:Name="ConsoleSearchSlot">
                                            <Border x:Name="ConsoleSearchField" Width="{Binding ActualWidth, ElementName=ConsoleSearchSlot}" MaxWidth="220" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    CornerRadius="14" BorderThickness="0.5">
                                                <Border.Style><Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource VP.BorderLightBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource VP.AccentBrush}" /></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" /></Trigger>
                                                    </Style.Triggers>
                                                </Style></Border.Style>
                                                <Grid>
                                                    <TextBox x:Name="ConsoleSearchBox" MinWidth="40" Height="26" Margin="10,0,32,0" Padding="0" BorderThickness="0"
                                                             Background="Transparent" Foreground="{DynamicResource VP.TextPrimaryBrush}" CaretBrush="{DynamicResource VP.TextPrimaryBrush}"
                                                             VerticalContentAlignment="Center" FontSize="12"
                                                             ToolTip="{loc:Loc ConsoleSearchToolTip}" AutomationProperties.Name="{loc:Loc ConsoleSearchToolTip}" TextChanged="ConsoleSearch_TextChanged">
                                                        <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template>
                                                    </TextBox>
                                                    <TextBlock x:Name="ConsoleSearchPlaceholder" Text="{loc:Loc ConsoleSearchPlaceholder}" Margin="10,0,32,0" FontSize="12"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource VP.TextTertiaryBrush}" IsHitTestVisible="False">
                                                        <TextBlock.Style><Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=ConsoleSearchBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock x:Name="ConsoleSearchIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,10,0"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource VP.TextSecondaryBrush}" IsHitTestVisible="False">
                                                        <TextBlock.Style><Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=ConsoleSearchBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <Button x:Name="ConsoleSearchClearButton" Width="20" Height="20" Margin="0,0,4,0" Padding="0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource VP.TextSecondaryBrush}"
                                                            ToolTip="{loc:Loc ConsoleClearSearchToolTip}" AutomationProperties.Name="{loc:Loc ConsoleClearSearchToolTip}" Click="ConsoleSearchClear_Click">
                                                        <Button.Style><Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text.Length, ElementName=ConsoleSearchBox}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}" /></Trigger>
                                                            </Style.Triggers>
                                                        </Style></Button.Style>
                                                        <Button.Template><ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="10" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                        </ControlTemplate></Button.Template>
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            </Grid>
                                            <ItemsControl x:Name="ConsoleLevelCounts" Grid.Column="1" MaxWidth="280" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="8,4,0,4" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource VP.TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <ListBox x:Name="ConsoleItemsControl" Grid.Row="1" Padding="12,4,12,8" Background="Transparent" BorderThickness="0"
                                                 FontFamily="Cascadia Code, SF Mono, Menlo, Consolas, monospace" FontSize="12.5"
                                                 SelectionMode="Extended" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                                                 ScrollViewer.ScrollChanged="ConsoleScrollChanged" PreviewKeyDown="ConsoleItems_PreviewKeyDown">
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource VP.SurfaceHoverBrush}" /></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate></Setter.Value></Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,2" MinHeight="22" MaxHeight="58" ContextMenu="{StaticResource ConsoleContextMenu}">
                                                        <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,2,28,2"><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{Binding TimeBrush, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding LevelText, Mode=OneWay}" Foreground="{Binding LevelBrush, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding DisplayMessage, Mode=OneWay}" Foreground="{Binding MessageBrush, Mode=OneWay}" /></TextBlock>
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,1,3,0"
                                                                Padding="2"
                                                                Cursor="Hand"
                                                                Background="Transparent"
                                                                MouseLeftButtonDown="ConsoleCopyButton_MouseLeftButtonDown"
                                                                ToolTip="{loc:Loc CopyMessageToolTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource VP.TextSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button x:Name="ConsoleLatestButton" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                Width="30" Height="30" Padding="0" Style="{DynamicResource VP.ButtonIcon}" Visibility="Collapsed"
                                                ToolTip="{loc:Loc ConsoleLatestToolTip}" AutomationProperties.Name="{loc:Loc ConsoleLatestToolTip}" Click="ConsoleLatest_Click">
                                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Chat panel area -->
                <GridSplitter x:Name="ChatSplitter"
                              Grid.RowSpan="3"
                              Grid.Column="1"
                              Style="{DynamicResource VP.GridSplitterV}"
                              Width="12"
                              Margin="0"
                              Background="Transparent">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <Border Width="2"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource VP.BorderSubtleBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid x:Name="ChatPanelViewport"
                      Grid.RowSpan="3"
                      Grid.Column="2"
                      ClipToBounds="True"
                      SizeChanged="ChatPanelViewport_SizeChanged">
                    <Border x:Name="ChatPanelContainer"
                            HorizontalAlignment="Stretch">
                        <views:ChatPanel x:Name="ChatPanel"
                                         Visibility="Visible" />
                    </Border>
                </Grid>

            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：磁盘信息 -->
                <DockPanel Grid.Column="0" LastChildFill="False">
                    <DockPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DockPanel.Resources>

                    <TextBlock>
                        <Run Text="{loc:Loc CapacityLabel}" FontWeight="SemiBold" />
                        <Run Text="{Binding DriveCapacity, Mode=OneWay}" />
                    </TextBlock>
                    <Rectangle Width="1" Height="12" Margin="10,0"
                               Fill="{DynamicResource VP.BorderSubtleBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock>
                        <Run Text="{loc:Loc UsedLabel}" FontWeight="SemiBold" />
                        <Run Text="{Binding UsedSpace, Mode=OneWay}" />
                    </TextBlock>
                    <Rectangle Width="1" Height="12" Margin="10,0"
                               Fill="{DynamicResource VP.BorderSubtleBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock>
                        <Run Text="{loc:Loc FreeLabel}" FontWeight="SemiBold" />
                        <Run Text="{Binding FreeSpace, Mode=OneWay}" />
                    </TextBlock>
                    <Rectangle Width="1" Height="12" Margin="10,0"
                               Fill="{DynamicResource VP.BorderSubtleBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock>
                        <Run Text="{loc:Loc FilesLabel}" FontWeight="SemiBold" />
                        <Run Text="{Binding FileCount, Mode=OneWay}" />
                    </TextBlock>
                    <Rectangle Width="1" Height="12" Margin="10,0"
                               Fill="{DynamicResource VP.BorderSubtleBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock>
                        <Run Text="{loc:Loc FoldersLabel}" FontWeight="SemiBold" />
                        <Run Text="{Binding FolderCount, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <!-- 右侧：版本号 -->
                <TextBlock x:Name="VersionDisplay"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           FontSize="14"
                           Margin="0,0,4,0"
                           Cursor="Hand"
                           ToolTip="{loc:Loc VersionDisplayToolTip}"
                           MouseLeftButtonDown="VersionDisplay_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource VP.AccentTextBrush}" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="v" /><Run Text="{Binding UpdateVM.CurrentVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 非模态提示不抢焦点、不拦截输入，也不遮挡原有确认覆盖层。 -->
        <Border x:Name="OperationToast"
                Grid.Row="1" Panel.ZIndex="100"
                Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MaxWidth="560" Margin="16,0,16,24" Padding="16,12"
                CornerRadius="10"
                Background="{DynamicResource VP.BackgroundBrush}"
                BorderBrush="{DynamicResource VP.BorderSubtleBrush}" BorderThickness="1"
                AutomationProperties.LiveSetting="Polite">
            <TextBlock x:Name="OperationToastText"
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource VP.TextPrimaryBrush}" />
        </Border>

        <!-- App Modal Overlay -->
        <controls:AppModalHost x:Name="ModalHost"
                               Grid.RowSpan="2"
                               Panel.ZIndex="200" />
    </Grid>
</Window>

