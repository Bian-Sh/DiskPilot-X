<UserControl x:Class="DiskPilotX.App.Controls.SkillTableControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
 xmlns:c="clr-namespace:DiskPilotX.App.Converters"
 Focusable="False" HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <c:BoolToVisibilityConverter x:Key="BoolVis"/>
  <!-- 叠色仅引用宿主色值，避免通用 Surface 的高透明度造成整表深灰。 -->
  <SolidColorBrush x:Key="TableHeaderBrush" Color="{DynamicResource VP.TextPrimary}" Opacity="0.035"/>
  <SolidColorBrush x:Key="TableHoverBrush" Color="{DynamicResource VP.TextPrimary}" Opacity="0.025"/>
  <SolidColorBrush x:Key="TableSelectionBrush" Color="{DynamicResource VP.Accent}" Opacity="0.09"/>
  <SolidColorBrush x:Key="TableDividerBrush" Color="{DynamicResource VP.TextPrimary}" Opacity="0.08"/>
  <SolidColorBrush x:Key="VP.SurfaceBrush" Color="{DynamicResource VP.TextPrimary}" Opacity="0.035"/>
  <SolidColorBrush x:Key="VP.SurfaceHoverBrush" Color="{DynamicResource VP.TextPrimary}" Opacity="0.025"/>
  <Style x:Key="TableHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource VP.TextSecondaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource TableDividerBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="12,10"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="TableRow" TargetType="DataGridRow">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
   <Setter Property="MinHeight" Value="40"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/></Trigger>
    <DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource TableSelectionBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="TableCell" TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Foreground" Value="{DynamicResource VP.TextPrimaryBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource TableSelectionBrush}"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="TableAction"><ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource ItemActionButton}"/></DataTemplate>
 </UserControl.Resources>
 <Border x:Name="Container" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource VP.BorderLightBrush}" Background="{DynamicResource VP.SkillWindowSurfaceBrush}">
  <Grid x:Name="Body" SizeChanged="Body_SizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="1">
    <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column"
      RowHeaderWidth="0" BorderThickness="0" Background="Transparent" FontSize="12"
      Foreground="{DynamicResource VP.TextPrimaryBrush}" FontFamily="{DynamicResource VP.FontFamily}"
      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableDividerBrush}"
      ColumnHeaderStyle="{StaticResource TableHeader}" RowStyle="{StaticResource TableRow}" CellStyle="{StaticResource TableCell}"
      SelectionUnit="Cell" MaxHeight="480" MinHeight="90" EnableRowVirtualization="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
      AutomationProperties.Name="{loc:Loc SkillTableAccessibleName}">
     <DataGrid.Columns>
      <DataGridTemplateColumn x:Name="SelectionColumn" Width="44" MinWidth="44" MaxWidth="44" CanUserResize="False">
       <DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllCheckBox" Style="{DynamicResource VP.CheckBox}" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" Indeterminate="SelectAll_Changed"
        IsThreeState="True" HorizontalAlignment="Center" AutomationProperties.Name="{loc:Loc SkillTableSelectAll}" ToolTip="{loc:Loc SkillTableSelectAll}"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource VP.CheckBox}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Path}" Visibility="{Binding Selectable,Converter={StaticResource BoolVis}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyHint" Text="{loc:Loc SkillTableEmpty}" Foreground="{DynamicResource VP.TextTertiaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0" IsHitTestVisible="False"/>
   </Grid>
   <Border x:Name="SelectionBar" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TableDividerBrush}" Padding="12,8">
    <DockPanel LastChildFill="True">
     <Button x:Name="InvertButton" DockPanel.Dock="Right" Content="{loc:Loc SkillTableInvert}" AutomationProperties.Name="{loc:Loc SkillTableInvert}" Style="{DynamicResource VP.Button}" Padding="10,4" Click="Invert_Click"/>
     <TextBlock x:Name="SelectionText" FontSize="11" Foreground="{DynamicResource VP.TextSecondaryBrush}" VerticalAlignment="Center"/>
    </DockPanel>
   </Border>
  </Grid>
 </Border>
</UserControl>
