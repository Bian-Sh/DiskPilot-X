<UserControl x:Class="DiskPilotX.App.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiskPilotX.App.Controls"
             xmlns:loc="clr-namespace:DiskPilotX.App.Localization"
             xmlns:converters="clr-namespace:DiskPilotX.App.Converters"
             Height="36"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="UpdateBoolToVis" />
        <converters:ReleaseNotesMarkdownConverter x:Key="UpdateMarkdown" />
    </UserControl.Resources>
    <Grid Background="Transparent"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: App icon + title -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="16,0"
                    IsHitTestVisible="False">
            <TextBlock Text="&#xE74E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Foreground="{DynamicResource VP.AccentTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{DynamicResource VP.TextPrimaryBrush}"
                       FontFamily="{DynamicResource VP.FontFamily}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Right: Settings + Window controls -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="UpdateButton"
                    DataContext="{Binding UpdateVM, RelativeSource={RelativeSource AncestorType={x:Type controls:WindowTitleBar}}}"
                    Visibility="{Binding IsUpdateEntryVisible, Converter={StaticResource UpdateBoolToVis}}"
                    AutomationProperties.Name="{loc:Loc UpdateEntry}"
                    Width="Auto" MinWidth="46" MaxWidth="180" FontSize="18"
                    AutomationProperties.HelpText="{Binding StatusText}"
                    Foreground="{DynamicResource VP.AccentTextBrush}"
                    Style="{DynamicResource VP.TitleBarButton}"
                    Command="{Binding ActivateUpdateCommand}"
                    MouseEnter="UpdateButton_MouseEnter">
                <StackPanel Orientation="Horizontal" Margin="12,0">
                    <TextBlock Text="{Binding UpdateEntryGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UpdateEntryHint}" FontFamily="{DynamicResource VP.FontFamily}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateEntryHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Popup x:Name="UpdateReleasePopup" PlacementTarget="{Binding ElementName=UpdateButton}"
                   Placement="Bottom" HorizontalOffset="-310" StaysOpen="True" AllowsTransparency="True"
                   DataContext="{Binding UpdateVM, RelativeSource={RelativeSource AncestorType={x:Type controls:WindowTitleBar}}}">
                <Border x:Name="UpdatePopupContent" Width="380" MaxHeight="420" Padding="16,14"
                        Background="{DynamicResource VP.BackgroundAltBrush}"
                        BorderBrush="{DynamicResource VP.BorderLightBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LatestVersion}" FontSize="12" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                                <TextBlock Text="{loc:Loc ReleaseNotesHeader}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource VP.TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PublishedAt}" FontSize="12" Foreground="{DynamicResource VP.TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource VP.BorderSubtleBrush}"/>
                        <ScrollViewer x:Name="UpdateReleaseScroll" Grid.Row="2" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="UpdateReleaseScroll_PreviewMouseWheel">
                            <FlowDocumentScrollViewer Document="{Binding ReleaseNotes, Converter={StaticResource UpdateMarkdown}}"
                                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                      IsToolBarVisible="False" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
            <Button x:Name="SettingsButton"
                    Visibility="{Binding ApplicationToolsVisibility, RelativeSource={RelativeSource AncestorType={x:Type controls:WindowTitleBar}}}"
                    Content="&#xE713;"
                    FontSize="18"
                    Style="{DynamicResource VP.TitleBarButton}"
                    Click="SettingsButton_Click"
                    ToolTip="{loc:Loc SettingsButtonToolTip}" />
            <Button x:Name="CollapseChatButton"
                    Visibility="{Binding ApplicationToolsVisibility, RelativeSource={RelativeSource AncestorType={x:Type controls:WindowTitleBar}}}"
                    Style="{DynamicResource VP.TitleBarButton}"
                    Click="CollapseChatButton_Click"
                    ToolTip="{loc:Loc CollapseChatPanelToolTip}">
                <Button.Content>
                    <Grid Width="16" Height="20">
                        <!-- Chat open: rectangle with divider slightly right (right panel = chat) -->
                        <Grid x:Name="PanelOpenIcon">
                            <Border BorderBrush="{DynamicResource VP.TextSecondaryBrush}"
                                    BorderThickness="1" CornerRadius="2" />
                            <Line X1="9.5" Y1="0" X2="9.5" Y2="20"
                                  Stroke="{DynamicResource VP.TextSecondaryBrush}" StrokeThickness="1" />
                        </Grid>
                        <!-- Chat collapsed: rectangle with divider slightly left (left panel = chat) -->
                        <Grid x:Name="PanelClosedIcon" Visibility="Collapsed">
                            <Border BorderBrush="{DynamicResource VP.TextSecondaryBrush}"
                                    BorderThickness="1" CornerRadius="2" />
                            <Line X1="6.5" Y1="0" X2="6.5" Y2="20"
                                  Stroke="{DynamicResource VP.TextSecondaryBrush}" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Button.Content>
            </Button>
            <Button x:Name="MinimizeButton"
                    Content="&#xE921;"
                    Style="{DynamicResource VP.TitleBarButton}"
                    Click="MinimizeButton_Click"
                    ToolTip="{loc:Loc MinimizeToolTip}" />
            <Button x:Name="MaximizeButton"
                    Content="&#xE922;"
                    Style="{DynamicResource VP.TitleBarButton}"
                    Click="MaximizeButton_Click"
                    ToolTip="{loc:Loc MaximizeToolTip}" />
            <Button x:Name="CloseButton"
                    Content="&#xE8BB;"
                    Style="{DynamicResource VP.TitleBarCloseButton}"
                    Click="CloseButton_Click"
                    ToolTip="{loc:Loc CloseToolTip}" />
        </StackPanel>
    </Grid>
</UserControl>

