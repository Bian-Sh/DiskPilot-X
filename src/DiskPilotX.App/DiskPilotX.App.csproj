<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiskPilotX.Core\DiskPilotX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\QR_Alipay.jpg" />
    <Resource Include="Assets\QR_WeChat.jpg" />
    <Resource Include="Assets\sendheart.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\skills\**\*.*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>DiskPilot-X</AssemblyName>
    <RootNamespace>DiskPilotX.App</RootNamespace>
    <AssemblyTitle>DiskPilot-X</AssemblyTitle>
    <Product>DiskPilot-X</Product>
    <Description>Disk space management Copilot</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 沿用main的正式/测试清单，兼容此前树状图测试包参数；不向依赖项目传全局清单。 -->
    <DiskPilotTestPackage Condition="'$(DiskPilotTestPackage)' == '' and '$(DiskPilotRequestElevation)' == 'false'">true</DiskPilotTestPackage>
    <ApplicationManifest Condition="'$(DiskPilotTestPackage)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(DiskPilotTestPackage)' == 'true'">app.test.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- 只保留简体中文、繁体中文与英文卫星资源，避免 Roslyn/依赖包全量语言文件夹冗余（与 Codex 打包一致） -->
    <SatelliteResourceLanguages>zh-CN;zh-TW;zh-Hans;zh-Hant;en;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>

